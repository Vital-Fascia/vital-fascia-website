---
import Photo from './Photo.astro';
import { getContent } from '../lib/content';
const d = await getContent('about');
---
{d.visible && (
  <section id="about" class="band">
    <div class="wrap grid">
      <Photo class="about-photo" image={d.photo} alt={d.photoAlt} placeholder={d.photoPlaceholder} sizes="(max-width: 980px) 100vw, 480px" />
      <div class="copy">
        <span class="eyebrow">{d.eyebrow}</span>
        <h2>{d.heading}</h2>
        <span class="rule"></span>
        {d.paragraphs.map((p: string) => <p>{p}</p>)}
        <p class="sig">{d.signature}</p>
      </div>
    </div>
  </section>
)}

<style>
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 72px); align-items: center; margin-top: 20px; }
  .grid :global(.about-photo) { width: 100%; aspect-ratio: 3/4; }
  h2 { font-size: clamp(28px, 3.6vw, 40px); }
  .copy p { font-size: 17px; line-height: 1.75; color: var(--ink-muted); margin-top: 18px; max-width: 560px; }
  .rule + p { margin-top: 24px; }
  .copy p.sig { margin-top: 30px; font-family: var(--font-display); font-style: italic; font-size: 20px; color: var(--ink); }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr; } }
</style>
