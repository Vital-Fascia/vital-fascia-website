---
import Photo from './Photo.astro';
import { getContent } from '../lib/content';
const d = await getContent('about');
---
{d.visible && (
  <section id="about" class="band">
    <div class="wrap grid">
      <div class="side">
        <Photo class="about-photo" image={d.photo} alt={d.photoAlt} placeholder={d.photoPlaceholder} sizes="(max-width: 980px) 100vw, 480px" />
        <div class="stat" data-reveal>
          <span class="stat-num" data-count>{d.statValue}</span>
          <span class="stat-label">{d.statLabel}</span>
        </div>
      </div>
      <div class="copy">
        <span class="eyebrow" data-reveal>{d.eyebrow}</span>
        <h2 data-reveal data-reveal-delay="60">{d.heading}</h2>
        <blockquote class="pull" data-reveal data-reveal-delay="100">{d.pullQuote}</blockquote>
        <div data-reveal data-reveal-delay="140">
          {d.paragraphs.map((p: string) => <p>{p}</p>)}
          <p class="sig">{d.signature}</p>
        </div>
        {d.credentials.length > 0 && (
          <ul class="creds" aria-label="Qualifications" data-reveal data-reveal-delay="180">
            {d.credentials.map((c: any) => <li><strong>{c.title}</strong><span>{c.detail}</span></li>)}
          </ul>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .side :global(.about-photo) { width: 100%; aspect-ratio: 3/4; }
  .stat { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--stone-line); display: flex; align-items: baseline; gap: 16px; }
  .stat-num { font-family: var(--font-display); font-size: clamp(34px, 4vw, 46px); color: var(--olive); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .stat-label { font-size: 14px; line-height: 1.45; color: var(--ink-muted); max-width: 22ch; }
  h2 { font-size: clamp(28px, 3.6vw, 40px); }
  .pull { margin: 28px 0 0; padding: 0 0 0 22px; border: 0; border-left: 2px solid var(--olive); font-family: var(--font-display); font-style: italic; font-size: clamp(24px, 3vw, 34px); line-height: 1.3; color: var(--olive-dark); max-width: 640px; }
  .copy p { font-size: 17px; line-height: 1.75; color: var(--ink-muted); margin-top: 18px; max-width: 560px; }
  .pull + div p:first-child { margin-top: 30px; }
  .copy p.sig { margin-top: 26px; font-family: var(--font-display); font-style: italic; font-size: 20px; color: var(--ink); }
  .creds { margin-top: 34px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0; border-top: 1px solid var(--stone-line); max-width: 640px; }
  .creds li { padding: 16px 16px 0 0; display: flex; flex-direction: column; gap: 2px; }
  .creds strong { font-size: 14.5px; font-weight: 600; }
  .creds span { font-size: 13.5px; color: var(--ink-muted); }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .side :global(.about-photo) { aspect-ratio: 4/3; }
  }
</style>
