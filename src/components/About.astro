---
import Photo from './Photo.astro';
import { getContent } from '../lib/content';
const d = await getContent('about');
---
{d.visible && (
  <section id="about" class="band">
    <div class="wrap grid">
      <div class="side">
        <Photo class="about-photo" image={d.photo} alt={d.photoAlt} placeholder={d.photoPlaceholder} sizes="(max-width: 980px) 100vw, 480px" />
      </div>
      <div class="copy">
        <span class="eyebrow" data-reveal>{d.eyebrow}</span>
        <h2 data-reveal data-reveal-delay="60">{d.heading}</h2>
        <blockquote class="pull" data-reveal data-reveal-delay="100">{d.pullQuote}</blockquote>
        <div data-reveal data-reveal-delay="140">
          {d.paragraphs.map((p: string) => <p>{p}</p>)}
          <p class="sig">{d.signature}</p>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .side :global(.about-photo) { width: 100%; aspect-ratio: 3/4; }
  h2 { font-size: clamp(28px, 3.6vw, 40px); }
  .pull { margin: 28px 0 0; padding: 0 0 0 22px; border: 0; border-left: 2px solid var(--olive); font-family: var(--font-display); font-style: italic; font-size: clamp(24px, 3vw, 34px); line-height: 1.3; color: var(--olive-dark); max-width: 640px; }
  .copy p { font-size: 17px; line-height: 1.75; color: var(--ink-muted); margin-top: 18px; max-width: 560px; }
  .pull + div p:first-child { margin-top: 30px; }
  .copy p.sig { margin-top: 26px; font-family: var(--font-display); font-style: italic; font-size: 20px; color: var(--ink); }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .side :global(.about-photo) { aspect-ratio: 4/3; }
    /* portrait is 3:4: keep the face in frame when cropped to landscape */
    .side :global(.about-photo img) { object-position: center 14%; }
  }
</style>
