---
import Photo from './Photo.astro';
import { getContent } from '../lib/content';
const d = await getContent('whoItsFor');
---
{d.visible && (
  <section id="recognition" class="band recog">
    <div class="wrap split">
      <div class="lead">
        <span class="eyebrow" data-reveal>{d.eyebrow}</span>
        <h2 data-reveal data-reveal-delay="80">{d.heading}</h2>
        <span class="rule" data-reveal data-reveal-delay="120"></span>
        <p class="lede intro" data-reveal data-reveal-delay="160">{d.intro}</p>
        <div data-reveal data-reveal-delay="200">
          <Photo class="recog-photo" image={d.photo} alt={d.photoAlt} placeholder={d.photoPlaceholder} sizes="(max-width: 980px) 100vw, 480px" />
        </div>
      </div>
      <ol class="signs">
        {d.signs.map((s: string, i: number) => (
          <li data-reveal data-reveal-delay={Math.min(i, 5) * 70}>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p>{s}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="wrap">
      <blockquote class="close" data-reveal>{d.closing}</blockquote>
    </div>
  </section>
)}

<style>
  .recog { background: var(--sand); --ink-soft: var(--ink-muted); }
  .split { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(36px, 6vw, 96px); align-items: start; }
  h2 { font-size: clamp(32px, 4.2vw, 50px); line-height: 1.1; }
  .intro { margin-top: 18px; }
  .lead :global(.recog-photo) { width: 100%; aspect-ratio: 4/3; margin-top: 36px; }
  .signs { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--stone); }
  .signs li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; padding: 22px 0; border-bottom: 1px solid var(--stone); align-items: baseline; }
  .n { font-family: var(--font-display); font-style: italic; color: var(--olive); font-size: 17px; }
  .signs p { font-family: var(--font-display); font-size: clamp(19px, 2vw, 22px); line-height: 1.35; }
  .close { margin: clamp(44px, 6vw, 80px) 0 0; padding: 0; max-width: 900px; font-family: var(--font-display); font-style: italic; font-size: clamp(25px, 3.6vw, 40px); line-height: 1.3; color: var(--olive-dark); border: 0; }
  .close::before { content: ''; display: block; width: 44px; height: 2px; background: var(--olive); margin-bottom: 24px; }
  @media (max-width: 980px) {
    .split { grid-template-columns: 1fr; }
    .lead :global(.recog-photo) { aspect-ratio: 16/10; }
  }
</style>
