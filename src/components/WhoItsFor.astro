---
import { getContent } from '../lib/content';
const d = await getContent('whoItsFor');
---
{d.visible && (
  <section id="recognition" class="band">
    <div class="wrap">
      <span class="eyebrow">{d.eyebrow}</span>
      <h2 class="h2">{d.heading}</h2>
      <span class="rule"></span>
      <p class="lede intro">{d.intro}</p>
      <ul class="grid">
        {d.signs.map((s: string) => <li class="card"><span class="dot"></span><p>{s}</p></li>)}
      </ul>
      <p class="close">{d.closing}</p>
    </div>
  </section>
)}

<style>
  .intro { margin-top: 18px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 48px; }
  .card { background: var(--white); border: 1px solid var(--stone-line); padding: 26px; display: flex; gap: 16px; align-items: flex-start; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--olive); margin-top: 9px; }
  .card p { font-size: 16px; line-height: 1.5; }
  .close { margin-top: 40px; font-family: var(--font-display); font-style: italic; font-size: 21px; line-height: 1.5; max-width: 680px; }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
</style>
