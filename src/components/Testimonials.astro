---
import { getContent } from '../lib/content';
const d = await getContent('testimonials');
---
{d.visible && d.items.length > 0 && (
  <section id="testimonials" class="testimonials band dark" data-carousel>
    <div class="wrap">
      <span class="eyebrow" data-reveal>{d.eyebrow}</span>
      <h2 data-reveal data-reveal-delay="80">{d.heading}</h2>

      <div class="scroll" tabindex="0" role="region" aria-label="Client testimonials" data-scroll data-reveal data-reveal-delay="120">
        {d.items.map((t: any) => (
          <figure class="card">
            <div class="stars" role="img" aria-label={`${t.rating} out of 5 stars`}>{'★'.repeat(t.rating)}</div>
            <blockquote>“{t.quote}”</blockquote>
            <div class="divider"></div>
            <figcaption>
              <span class="name">{t.name}</span>
              {t.detail && <span class="ctx">{t.detail}</span>}
            </figcaption>
            {t.source && <span class="source">{t.source}</span>}
          </figure>
        ))}
      </div>

      <div class="controls" data-controls>
        <button type="button" class="arrow" data-dir="-1" aria-label="Previous testimonials">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <div class="dots" data-dots></div>
        <button type="button" class="arrow" data-dir="1" aria-label="Next testimonials">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </div>
  </section>
)}

<script>
  // Paged carousel: 3 / 2 / 1 cards per view (CSS), so cards always fill the width with none
  // hanging off the edge. Arrows + dots live together under the cards. Recalculates on resize.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-scroll]')!;
    const dotsEl = root.querySelector<HTMLElement>('[data-dots]')!;
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-dir="-1"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-dir="1"]')!;
    const count = track.children.length;
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pages = 1;

    const perView = () => Math.max(1, parseInt(getComputedStyle(track).getPropertyValue('--per')) || 1);
    const gap = () => parseFloat(getComputedStyle(track).columnGap) || 0;
    const pageW = () => track.clientWidth + gap();
    const maxLeft = () => track.scrollWidth - track.clientWidth;
    const current = () => {
      if (track.scrollLeft >= maxLeft() - 2) return pages - 1;
      return Math.min(pages - 1, Math.round(track.scrollLeft / pageW()));
    };
    const go = (page: number) => {
      const p = Math.max(0, Math.min(pages - 1, page));
      track.scrollTo({ left: Math.min(p * pageW(), maxLeft()), behavior: reduce() ? 'auto' : 'smooth' });
    };
    const sync = () => {
      const c = current();
      prev.disabled = c <= 0;
      next.disabled = c >= pages - 1;
      dotsEl.querySelectorAll('button').forEach((b, i) => {
        b.setAttribute('aria-current', String(i === c));
        b.classList.toggle('on', i === c);
      });
    };
    const build = () => {
      pages = Math.max(1, Math.ceil(count / perView()));
      controls.hidden = pages <= 1;
      dotsEl.replaceChildren(
        ...Array.from({ length: pages }, (_, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('aria-label', `Go to testimonials page ${i + 1} of ${pages}`);
          b.addEventListener('click', () => go(i));
          return b;
        }),
      );
      sync();
    };
    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(build).observe(track);
    build();
  });
</script>

<style>
  .testimonials { background: var(--olive); color: var(--cream); }
  .testimonials :global(.eyebrow) { color: var(--cream); }
  h2 { font-size: clamp(30px, 4vw, 44px); color: var(--cream); font-style: italic; font-weight: 400; }
  .stars { color: var(--gold); font-size: 14px; letter-spacing: 3px; }

  .scroll { --per: 3; --gap: 20px; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; margin-top: 44px; padding-block: 4px 8px; scrollbar-width: none; }
  .scroll::-webkit-scrollbar { display: none; }
  .scroll:focus-visible { outline: 2px solid var(--cream); outline-offset: 4px; }
  .card { scroll-snap-align: start; background: var(--white); color: var(--ink); border-radius: var(--radius); padding: 30px 28px; display: flex; flex-direction: column; margin: 0; min-width: 0; }
  .card blockquote { font-family: var(--font-display); font-style: italic; font-size: 19px; line-height: 1.5; margin: 16px 0 0; flex-grow: 1; }
  .divider { width: 100%; height: 1px; background: var(--stone-line); margin: 22px 0 16px; }
  .name { font-weight: 600; display: block; margin-bottom: 2px; font-size: 15px; }
  .ctx { color: var(--ink-muted); font-size: 13.5px; }
  .source { display: block; margin-top: 12px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted); }

  /* arrows and dots together, centred under the cards */
  .controls { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 28px; }
  .controls[hidden] { display: none; }
  .dots { display: flex; gap: 4px; align-items: center; }
  .dots :global(button) { width: 28px; height: 44px; padding: 0; border: 0; background: transparent; position: relative; }
  .dots :global(button)::after { content: ''; position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: rgba(242, 236, 221, 0.4); transition: background .3s ease, width .3s var(--ease), margin .3s var(--ease), border-radius .3s ease; }
  .dots :global(button.on)::after { background: var(--cream); width: 22px; margin-left: -11px; border-radius: 4px; }
  .dots :global(button:focus-visible) { outline: 2px solid var(--cream); outline-offset: -4px; border-radius: 6px; }
  .arrow { width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid rgba(242, 236, 221, 0.6); background: transparent; color: var(--cream); display: flex; align-items: center; justify-content: center; padding: 0; transition: background .2s ease, opacity .2s ease; }
  .arrow:hover:not(:disabled) { background: rgba(242, 236, 221, 0.14); }
  .arrow:disabled { opacity: .35; cursor: default; }
  .arrow svg { width: 18px; height: 18px; }
  @media (max-width: 980px) { .scroll { --per: 2; } }
  @media (max-width: 640px) { .scroll { --per: 1; } }
  @media (prefers-reduced-motion: reduce) { .dots :global(button)::after { transition: none; } }
</style>
