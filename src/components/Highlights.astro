---
import { getContent } from '../lib/content';
const d = await getContent('highlights');
---
{d.visible && d.items.length > 0 && (
  <div class="stat-strip">
    <div class="wrap stat-row">
      {d.items.map((s: any) => (
        <div class="stat">
          <div class="stat-num">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .stat-strip { background: var(--charcoal); padding-block: 32px; }
  .stat-row { display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; }
  .stat { flex: 1; min-width: 160px; }
  .stat-num { font-family: var(--font-display); font-size: clamp(26px, 3vw, 34px); color: var(--cream); }
  .stat-label { font-size: 13px; color: var(--cream-muted); margin-top: 4px; }
  @media (max-width: 700px) { .stat-row { gap: 24px; } .stat { min-width: 120px; } }
</style>
