---
import { getContent } from '../lib/content';
const d = await getContent('highlights');
---
{d.visible && d.items.length > 0 && (
  <div class="stat-strip dark">
    <div class="wrap stat-row" style={`--cols:${d.items.length}`}>
      {d.items.map((s: any) => (
        <div class="stat">
          <div class="stat-num" data-count>{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .stat-strip { background: var(--charcoal); padding-block: 32px; }
  .stat-row { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: 24px 40px; text-align: center; }
  .stat-num { font-family: var(--font-display); font-size: clamp(26px, 3vw, 34px); color: var(--cream); font-variant-numeric: tabular-nums; }
  .stat-label { font-size: 13px; color: var(--cream-muted); margin-top: 4px; }
  @media (max-width: 560px) { .stat-row { gap: 12px; } .stat-label { font-size: 12px; } }
</style>
