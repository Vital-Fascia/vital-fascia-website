---
import { getContent } from '../lib/content';
const d = await getContent('highlights');
---
{d.visible && d.items.length > 0 && (
  <div class="stats">
    <div class="wrap stat-row">
      {d.items.map((s: any) => (
        <div class="stat">
          <span class="stat-num" data-count>{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .stats { background: var(--bone); padding-bottom: clamp(36px, 5vw, 56px); }
  .stat-row { display: flex; flex-wrap: wrap; gap: 14px clamp(28px, 6vw, 72px); padding-top: 28px; border-top: 1px solid var(--stone-line); }
  .stat { display: flex; align-items: baseline; gap: 12px; }
  .stat-num { font-family: var(--font-display); font-size: clamp(26px, 3vw, 34px); color: var(--olive); font-variant-numeric: tabular-nums; }
  .stat-label { font-size: 14px; color: var(--ink-muted); }
</style>
