---
import Icon from './Icon.astro';
import Collapse from './Collapse.astro';
import { getContent } from '../lib/content';
const d = await getContent('process');
const PER_ROW = 4;
const last = d.steps.length - 1;
// Snake layout on wide screens: row 1 runs left to right, row 2 right to left, so the 5th step
// sits directly under the 4th and a curved line links them. (Vertical single column below 1000px.)
const place = (i: number) => {
  const row = Math.floor(i / PER_ROW) + 1;
  const pos = i % PER_ROW;
  const ltr = row % 2 === 1;
  return { row, col: ltr ? pos + 1 : PER_ROW - pos, ltr, turn: pos === PER_ROW - 1 && i !== last };
};
---
{d.visible && (
  <section id="process" class="band process">
    <div class="wrap">
      <Collapse id="process" open={d.startOpen}>
        <Fragment slot="head">
          <span class="eyebrow">{d.eyebrow}</span>
          <h2 class="h2">{d.heading}</h2>
        </Fragment>
        <span class="rule"></span>
        <p class="lede intro">{d.intro}</p>

        <div class="journey" data-journey>
          <ol class="track">
            {d.steps.map((s: any, i: number) => {
              const p = place(i);
              return (
                <li
                  class:list={['step', { dest: i === last, rtl: !p.ltr, turn: p.turn, last: i === last }]}
                  style={`--row:${p.row};--col:${p.col}`}
                  tabindex="0"
                >
                  <div class="marker">
                    <Icon name={s.icon} />
                    <span class="num" aria-hidden="true">{i + 1}</span>
                  </div>
                  <div class="text">
                    <h3>{s.title}</h3>
                    <p>{s.description}</p>
                    {s.detail && <p class="detail">{s.detail}</p>}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </Collapse>
    </div>
  </section>
)}

<script>
  // Time-based reveal: when the journey comes into view each step lights up one after another
  // (a fixed rhythm, independent of how far the visitor scrolls). Runs once.
  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const light = (i: number) => {
      steps[i].classList.add('on');
      if (i > 0) steps[i - 1].classList.add('linked');
    };
    if (reduce || !('IntersectionObserver' in window)) {
      steps.forEach((_, i) => light(i));
      root.classList.add('static');
    } else {
      const STEP_MS = 650;
      let started = false;
      const run = () => {
        let i = 0;
        const tick = () => {
          if (i >= steps.length) return;
          const open = root.closest('.collapse')?.classList.contains('open') !== false;
          // wait if this step is still below the fold (matters on phones, where the list is tall)
          if (open && steps[i].getBoundingClientRect().top < innerHeight * 0.9) {
            light(i++);
            setTimeout(tick, STEP_MS);
          } else {
            setTimeout(tick, 150);
          }
        };
        tick();
      };
      const io = new IntersectionObserver(
        (entries) => {
          if (started || !entries.some((e) => e.isIntersecting)) return;
          started = true;
          io.disconnect();
          setTimeout(run, 250);
        },
        { threshold: 0.12 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .process { background: var(--bone); }
  .intro { margin-top: 18px; }
  .journey { margin-top: 48px; --line: var(--stone); --fill: var(--olive); }
  .track { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; }
  .step { position: relative; display: flex; gap: 20px; padding: 0 0 28px; outline-offset: 6px; transition: transform .3s var(--ease); }
  .step.last { padding-bottom: 0; }
  .marker { position: relative; flex: none; width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: var(--bone); border: 1.5px solid var(--stone); color: var(--olive); z-index: 1; transition: background .5s var(--ease), color .5s var(--ease), border-color .5s var(--ease); }
  .marker :global(.icon) { width: 32px; height: 32px; }
  .num { position: absolute; top: -6px; right: -6px; width: 22px; height: 22px; border-radius: 50%; background: var(--bone); border: 1px solid var(--stone); color: var(--ink-muted); font-size: 11px; font-weight: 600; display: grid; place-items: center; }
  .step.on .marker { background: var(--olive); border-color: var(--olive); color: var(--cream); }
  .step.dest .marker { box-shadow: 0 0 0 6px rgba(74, 82, 64, 0.12); }
  .text { margin-top: 6px; }
  h3 { font-size: 20px; }
  .step p { margin: 6px 0 0; font-size: 14.5px; line-height: 1.55; color: var(--ink-muted); max-width: 44ch; }
  .step .detail { color: var(--olive-dark); max-height: 0; overflow: hidden; opacity: 0; margin-top: 0; transition: max-height .4s var(--ease), opacity .4s ease, margin-top .4s var(--ease); }

  /* connecting lines: ::before is the grey track, ::after the olive fill that grows once the next step lights */
  .step:not(.last)::before, .step:not(.last)::after { content: ''; position: absolute; left: 31px; top: 32px; width: 2px; height: 100%; background: var(--line); }
  .step:not(.last)::after { background: var(--fill); transform: scaleY(0); transform-origin: top; transition: transform .5s var(--ease); }
  .step.linked::after { transform: scaleY(1); }
  :global(.js) .journey:not(.static) .text { opacity: .3; transform: translateY(10px); transition: opacity .6s var(--ease) .15s, transform .6s var(--ease) .15s; }
  :global(.js) .journey:not(.static) .step.on .text { opacity: 1; transform: none; }
  .step.on .marker { transition-delay: .25s; }
  .step:first-child.on .marker { transition-delay: 0s; }

  @media (hover: hover) {
    .step:hover { transform: translateY(-3px); }
    .step:hover .detail, .step:focus-within .detail { max-height: 5em; opacity: 1; margin-top: 10px; }
  }
  .step:focus-visible .detail { max-height: 5em; opacity: 1; margin-top: 10px; }
  @media (hover: none) { .step .detail { max-height: none; opacity: 1; margin-top: 8px; } }

  /* wide screens: two rows of four, snaking so the 5th step sits under the 4th */
  @media (min-width: 1000px) {
    .journey { margin-top: 56px; }
    .track { grid-template-columns: repeat(4, 1fr); row-gap: 64px; }
    .step { grid-row: var(--row); grid-column: var(--col); flex-direction: column; align-items: center; text-align: center; padding: 0 12px; gap: 0; }
    .step.last { padding-bottom: 0; }
    .text { margin-top: 20px; }
    .step p { margin-inline: auto; max-width: 200px; }
    .step.dest .marker { width: 72px; height: 72px; margin-top: -4px; }
    .step.dest .marker :global(.icon) { width: 36px; height: 36px; }
    /* horizontal links to the next step in the row */
    .step:not(.last)::before, .step:not(.last)::after { left: 50%; top: 32px; width: 100%; height: 2px; }
    .step.rtl:not(.last)::before, .step.rtl:not(.last)::after { left: auto; right: 50%; }
    .step:not(.last)::after { transform: scaleX(0); transform-origin: left; }
    .step.rtl:not(.last)::after { transform-origin: right; }
    .step.linked::after { transform: scaleX(1); }
    /* end of a row: a curved bracket drops to the step directly below */
    .step.turn::before, .step.turn::after { left: 50%; right: auto; top: 32px; width: calc(50% - 4px); height: calc(100% + 64px); background: transparent; border: 2px solid var(--line); border-left: 0; border-radius: 0 36px 36px 0; }
    .step.turn::after { border-color: var(--fill); transform: none; opacity: 0; transition: opacity .6s var(--ease); }
    .step.turn.linked::after { opacity: 1; }
    .step.turn.rtl::before, .step.turn.rtl::after { left: auto; right: 50%; border: 2px solid var(--line); border-right: 0; border-radius: 36px 0 0 36px; }
    .step.turn.rtl::after { border-color: var(--fill); border-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marker, .step, .step .detail, .step:not(.last)::after { transition: none; }
    .step:hover { transform: none; }
  }
</style>
