---
import Icon from './Icon.astro';
import { getContent } from '../lib/content';
const d = await getContent('process');
const last = d.steps.length - 1;
---
{d.visible && (
  <section id="process" class="band process">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{d.eyebrow}</span>
      <h2 class="h2" data-reveal data-reveal-delay="80">{d.heading}</h2>
      <span class="rule"></span>
      <p class="lede intro" data-reveal data-reveal-delay="120">{d.intro}</p>

      <div class="journey" data-journey>
        <div class="ends" aria-hidden="true"><span>{d.timelineStart}</span><span>{d.timelineEnd}</span></div>
        <div class="rail" aria-hidden="true"><span class="fill"></span></div>
        <ol class="track">
          {d.steps.map((s: any, i: number) => (
            <li class:list={['step', { dest: i === last }]} tabindex="0">
              <div class="marker">
                <Icon name={s.icon} />
                <span class="num" aria-hidden="true">{i + 1}</span>
              </div>
              <div class="text">
                {s.when && <span class="when">{s.when}</span>}
                <h3>{s.title}</h3>
                <p>{s.description}</p>
                {s.detail && <p class="detail">{s.detail}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

<script>
  // Progressive fill: the rail fills as the track scrolls through the viewport; each step
  // switches on when the fill reaches it. Under reduced motion everything is shown filled.
  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      root.style.setProperty('--p', '1');
      const fixRail = () => {
        const last = steps[steps.length - 1];
        const lm = last.querySelector<HTMLElement>('.marker')!;
        root.style.setProperty('--rail-h', matchMedia('(min-width: 981px)').matches ? 'auto' : `${last.offsetTop + lm.offsetHeight / 2 - 32}px`);
      };
      fixRail();
      window.addEventListener('resize', fixRail);
      steps.forEach((s) => s.classList.add('on'));
      root.classList.add('static');
    } else {
      let ticking = false;
      const update = () => {
        ticking = false;
        const vh = window.innerHeight;
        const r = root.getBoundingClientRect();
        const horizontal = matchMedia('(min-width: 981px)').matches;
        // desktop: the track is short, so progress over a fixed scroll distance; mobile: over the track's height
        const start = vh * 0.78;
        const span = horizontal ? vh * 0.6 : Math.max(r.height * 0.92, 1);
        const p = Math.min(1, Math.max(0, (start - r.top) / span));
        // vertical timeline: end the rail at the last marker's centre, not the end of its text
        const last = steps[steps.length - 1];
        const lastMarker = last.querySelector<HTMLElement>('.marker')!;
        root.style.setProperty('--rail-h', horizontal ? 'auto' : `${last.offsetTop + lastMarker.offsetHeight / 2 - 32}px`);
        root.style.setProperty('--p', p.toFixed(4));
        steps.forEach((s, i) => {
          const pos = steps.length === 1 ? 0 : i / (steps.length - 1);
          s.classList.toggle('on', p > 0 && p >= pos - 0.001);
        });
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }
  }
</script>

<style>
  .process { background: var(--bone); }
  .intro { margin-top: 18px; }
  .journey { --p: 0; position: relative; margin-top: 56px; }
  .ends { display: flex; justify-content: space-between; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 600; color: var(--ink-muted); margin-bottom: 18px; }
  .track { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .rail { position: absolute; left: 10%; right: 10%; top: 72px; height: 2px; background: var(--stone); }
  .fill { display: block; height: 100%; width: 100%; background: var(--olive); transform: scaleX(var(--p)); transform-origin: left; }
  .step { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 10px; outline-offset: 6px; transition: transform .3s var(--ease); }
  .marker { position: relative; width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: var(--bone); border: 1.5px solid var(--stone); color: var(--olive); transition: background .5s var(--ease), color .5s var(--ease), border-color .5s var(--ease), transform .5s var(--ease); z-index: 1; }
  .marker :global(.icon) { width: 32px; height: 32px; }
  .num { position: absolute; top: -6px; right: -6px; width: 22px; height: 22px; border-radius: 50%; background: var(--bone); border: 1px solid var(--stone); color: var(--ink-muted); font-size: 11px; font-weight: 600; display: grid; place-items: center; }
  .step.on .marker { background: var(--olive); border-color: var(--olive); color: var(--cream); }
  .step.dest .marker { width: 76px; height: 76px; margin-top: -6px; box-shadow: 0 0 0 6px rgba(74, 82, 64, 0.12); }
  .step.dest .marker :global(.icon) { width: 38px; height: 38px; }
  .text { margin-top: 22px; }
  .step.dest .text { margin-top: 16px; }
  .when { display: block; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--olive); font-weight: 600; margin-bottom: 6px; }
  h3 { font-size: 20px; }
  .step p { margin: 8px auto 0; font-size: 14.5px; line-height: 1.55; color: var(--ink-muted); max-width: 200px; }
  .step .detail { display: grid; font-size: 13.5px; color: var(--olive-dark); max-height: 0; overflow: hidden; opacity: 0; margin-top: 0; transition: max-height .4s var(--ease), opacity .4s ease, margin-top .4s var(--ease); }

  /* reveal: text fades up as the step activates (JS only) */
  :global(.js) .journey:not(.static) .text { opacity: .25; transform: translateY(10px); transition: opacity .6s var(--ease), transform .6s var(--ease); }
  :global(.js) .journey:not(.static) .step.on .text { opacity: 1; transform: none; }

  @media (hover: hover) {
    .step:hover { transform: translateY(-4px); }
    .step:hover .detail, .step:focus-within .detail { max-height: 5em; opacity: 1; margin-top: 10px; }
  }
  .step:focus-visible .detail { max-height: 5em; opacity: 1; margin-top: 10px; }
  @media (hover: none) { .step .detail { max-height: none; opacity: 1; margin-top: 8px; } }

  /* mobile + tablet: vertical timeline */
  @media (max-width: 980px) {
    .journey { margin-top: 40px; padding-left: 0; }
    .ends { display: none; }
    .track { grid-template-columns: 1fr; gap: 6px; }
    .rail { left: 31px; right: auto; top: 32px; width: 2px; height: var(--rail-h, 80%); }
    .fill { width: 100%; height: 100%; transform: scaleY(var(--p)); transform-origin: top; }
    .step { flex-direction: row; text-align: left; align-items: flex-start; padding: 0 0 26px; gap: 20px; }
    .step:last-child { padding-bottom: 0; }
    .text { margin-top: 6px; }
    .step.dest .text { margin-top: 12px; }
    .step.dest .marker { width: 64px; height: 64px; margin: 0; }
    .step.dest .marker :global(.icon) { width: 32px; height: 32px; }
    .step p { margin: 6px 0 0; max-width: 44ch; }
    .step:hover { transform: none; }
    .marker { flex: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fill, .marker, .step, .step .detail { transition: none; }
    .step:hover { transform: none; }
  }
</style>
