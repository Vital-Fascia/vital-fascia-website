---
import Photo from './Photo.astro';
interface Props { offer: any; bookingUrl: string; delay?: number }
const { offer, bookingUrl, delay = 0 } = Astro.props;
const soon = offer.status === 'soon';
const href = offer.buttonHref === '#' ? bookingUrl : offer.buttonHref;
---
<article class:list={['card', 'card-lift', { soon }]} data-reveal data-reveal-delay={delay}>
  {soon && (
    <Photo class="teaser" image={offer.photo} alt={offer.photoAlt} placeholder={offer.photoPlaceholder ?? ''} zoom={false} sizes="(max-width: 700px) 100vw, 480px" />
  )}
  <div class="body">
    <span class="badge">{offer.badge}</span>
    <h3>{offer.title}</h3>
    {offer.details && <p class="details">{offer.details}</p>}
    {offer.description && <p class="desc">{offer.description}</p>}
    {offer.price && <div class="price">{offer.price}{offer.priceNote && <span>{offer.priceNote}</span>}</div>}
    {offer.includes.length > 0 && (
      <>
        <ul class="includes">{offer.includes.map((i: string) => <li>{i}</li>)}</ul>
      </>
    )}
    {offer.expect.length > 0 && (
      <dl class="expect">
        {offer.expect.map((e: any) => <div><dt>{e.label}</dt><dd>{e.value}</dd></div>)}
      </dl>
    )}
    {offer.rebate && <p class="rebate">{offer.rebate}</p>}
    <a class:list={['btn', soon ? 'btn-ghost' : 'btn-primary btn-arrow']} href={href}>{offer.buttonLabel}</a>
  </div>
</article>

<style>
  .card { background: var(--white); border: 1px solid var(--stone-line); display: flex; flex-direction: column; border-radius: var(--radius); overflow: hidden; }
  .body { padding: 40px 38px; display: flex; flex-direction: column; flex: 1; }
  .card.soon { background: var(--bone); border: 1.5px dashed var(--stone); }
  .card.soon .body { padding-top: 28px; }
  .card :global(.teaser) { width: 100%; aspect-ratio: 16/9; border-radius: 0; border: 0; border-bottom: 1px dashed var(--stone); }
  .badge { display: inline-block; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 600; color: var(--olive); background: var(--sand); border: 1px solid var(--stone-line); padding: 6px 12px; align-self: flex-start; margin-bottom: 18px; }
  .soon .badge { background: transparent; }
  h3 { font-size: 26px; }
  .details { color: var(--ink-muted); margin-top: 8px; font-size: 15px; }
  .desc { color: var(--ink-muted); margin-top: 12px; font-size: 15px; line-height: 1.6; }
  .price { font-family: var(--font-display); font-size: 40px; margin: 18px 0 6px; }
  .price span { font-size: 16px; font-family: var(--font-body); color: var(--ink-muted); font-weight: 400; }
  .includes { margin-top: 20px; display: flex; flex-direction: column; gap: 12px; }
  .includes li { display: flex; gap: 12px; font-size: 15px; align-items: flex-start; }
  .includes li::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--olive); margin-top: 8px; }
  .expect { display: grid; gap: 0; margin: 24px 0 0; border-top: 1px solid var(--stone-line); }
  .expect div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--stone-line); font-size: 14px; }
  .expect dt { color: var(--ink-muted); }
  .expect dd { margin: 0; font-weight: 500; text-align: right; }
  .rebate { margin-top: 16px; font-size: 13.5px; color: var(--olive-dark); padding: 10px 14px; background: var(--bone); border-left: 2px solid var(--olive); }
  .btn { margin-top: auto; align-self: flex-start; }
  .includes + .btn, .rebate + .btn, .desc + .btn { margin-top: 28px; }
  .expect + .btn { margin-top: 28px; }
  @media (max-width: 700px) { .body { padding: 30px 24px; } .btn { align-self: stretch; } }
</style>
