---
// The optional "send me updates" choice (Yes / No). Wording, on/off and the default are all edited in the CMS
// (Business details & site settings > Marketing consent). It always sends exactly "Consent" or "No consent",
// so the CRM and the notification email get a clear answer either way (an unticked tick-box sends nothing at all).
import { getContent } from '../lib/content';
interface Props { form: 'callRequest' | 'contact' | 'waitlist'; id: string }
const { form, id } = Astro.props;
const c = await getContent('consent');
const show = c.enabled && { callRequest: c.showOnCallRequest, contact: c.showOnContact, waitlist: c.showOnWaitlist }[form];
---
{show && (
  <fieldset class="consent">
    <input type="hidden" name="marketing_consent_asked" value="1" />
    <legend>{c.label}</legend>
    <div class="opts">
      <label for={`${id}-yes`}><input id={`${id}-yes`} type="radio" name="marketing_consent" value="Consent" checked={c.preSelectYes} /> <span>{c.yesLabel}</span></label>
      <label for={`${id}-no`}><input id={`${id}-no`} type="radio" name="marketing_consent" value="No consent" checked={!c.preSelectYes} /> <span>{c.noLabel}</span></label>
    </div>
    {(c.smallPrint || c.privacyLinkText) && (
      <p class="sub">
        {c.smallPrint}
        {c.privacyLinkText && <> <a href="/privacy-policy" target="_blank" rel="noopener">{c.privacyLinkText}</a></>}
      </p>
    )}
  </fieldset>
)}

<style>
  .consent { border: 0; margin: 0; padding: 0; min-width: 0; }
  .consent legend { padding: 0; font-size: 13.5px; line-height: 1.45; color: var(--ink); }
  .consent .opts { display: flex; flex-wrap: wrap; gap: 4px 22px; margin-top: 6px; }
  .consent label { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-muted); cursor: pointer; min-height: 32px; }
  .consent input[type='radio'] { width: 18px; height: 18px; margin: 0; accent-color: var(--olive); cursor: pointer; }
  .consent input[type='radio']:focus-visible { outline: 2px solid var(--olive); outline-offset: 2px; }
  .consent .sub { margin: 2px 0 0; font-size: 12.5px; color: var(--ink-muted); }
  .consent a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  :global(.form-dark) .consent legend { color: var(--cream); }
  :global(.form-dark) .consent label, :global(.form-dark) .consent .sub { color: var(--cream-muted); }
  :global(.form-dark) .consent input[type='radio'] { accent-color: var(--cream); }
</style>
