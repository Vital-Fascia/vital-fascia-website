---
import { getContent } from '../lib/content';
import { formEndpoints } from '../lib/forms';
const d = await getContent('discoveryCall');
---
{d.visible && (
  <section id="discovery-call" class="call band">
    <div class="wrap grid">
      <div class="info">
        <span class="eyebrow" data-reveal>{d.eyebrow}</span>
        <h2 data-reveal data-reveal-delay="60">{d.heading}</h2>
        <div class="copy" data-reveal data-reveal-delay="100">{d.paragraphs.map((p: string) => <p>{p}</p>)}</div>
        <div class="next" data-reveal data-reveal-delay="140">
          <h3>{d.stepsHeading}</h3>
          <ol>
            {d.steps.map((s: string, i: number) => <li><span class="n" aria-hidden="true">{i + 1}</span><span>{s}</span></li>)}
          </ol>
        </div>
      </div>
      <form data-form data-success={d.successMessage} action={formEndpoints.discoveryCall || undefined} method="post" data-reveal data-reveal-delay="120">
        <div class="fields">
          <div class="field">
            <label for="call-name">{d.nameLabel}</label>
            <input id="call-name" name="name" type="text" autocomplete="name" placeholder={d.namePlaceholder} required />
          </div>
          <div class="field">
            <label for="call-phone">{d.phoneLabel}</label>
            <input id="call-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder={d.phonePlaceholder} required />
          </div>
          <div class="field">
            <label for="call-email">{d.emailLabel}</label>
            <input id="call-email" name="email" type="email" autocomplete="email" placeholder={d.emailPlaceholder} required />
          </div>
          <button type="submit" class="btn btn-primary btn-arrow">{d.buttonLabel}</button>
        </div>
        <p class="fine">{d.finePrint}</p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
)}

<style>
  .call { background: var(--sand); }
  .grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(36px, 6vw, 96px); align-items: start; }
  h2 { font-size: clamp(28px, 3.6vw, 42px); }
  .copy p { color: var(--ink-muted); font-size: 17px; line-height: 1.7; margin-top: 18px; max-width: 520px; }
  .next { margin-top: 34px; max-width: 520px; padding-top: 22px; border-top: 1px solid var(--stone); }
  .next h3 { font-family: var(--font-body); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; font-weight: 600; color: var(--olive); margin-bottom: 14px; }
  .next ol { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .next li { display: flex; gap: 14px; align-items: center; font-size: 16px; }
  .n { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--olive); color: var(--cream); font-size: 13px; font-weight: 600; display: grid; place-items: center; }
  form { background: var(--white); border: 1px solid var(--stone-line); border-radius: var(--radius); padding: clamp(24px, 3vw, 36px); }
  .fields { display: flex; flex-direction: column; gap: 18px; }
  form .btn { width: 100%; }
  .fine { font-size: 13px; color: var(--ink-muted); margin-top: 14px; }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr; } }
</style>
