---
import { Picture } from 'astro:assets';
import Collapse from './Collapse.astro';
import figure from '../assets/images/approach-figure-source.png';
import { getContent } from '../lib/content';
const d = await getContent('approach');

// One coordinate system: the image's own pixel space (figure.width x figure.height).
const W = figure.width;
const H = figure.height;
// Node positions measured from the calibration reference (centres of the glow points), in image px.
const pos: Record<string, [number, number]> = {
  jaw: [493, 178],
  neck: [502, 261],
  upperback: [501, 405],
  core: [509, 566],
  hip: [458, 694],
  knee: [494, 920],
  ankle: [513, 1194],
};
const order = ['jaw', 'neck', 'upperback', 'core', 'hip', 'knee', 'ankle'];
const pts = order.map((id) => pos[id]);
// Smooth (Catmull-Rom) cubic segment between each pair of neighbouring nodes, routed through every node.
const seg = (i: number) => {
  const p0 = pts[Math.max(0, i - 1)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(pts.length - 1, i + 2)];
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  const f = (n: number) => n.toFixed(1);
  return `M${f(p1[0])} ${f(p1[1])} C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
};
const segs = order.slice(0, -1).map((id, i) => ({ a: id, b: order[i + 1], d: seg(i) }));
const regionMap = Object.fromEntries(d.regions.map((r: any) => [r.id, r]));
const first = d.symptoms[0];
---
{d.visible && (
  <section id="approach" class="approach band dark" data-approach>
    <div class="wrap">
      <Collapse id="approach" open={d.startOpen}>
        <Fragment slot="head">
          <span class="eyebrow eyebrow-dark">{d.eyebrow}</span>
          <h2>{d.heading}</h2>
        </Fragment>

        <div class="grid">
          <div class="body-col">
            <p class="body" data-reveal>{d.body}</p>
            <div class="compare" data-reveal data-reveal-delay="100">
              <h3 class="cmp-h">{d.compareHeading}</h3>
              <div class="cmp">
                <div class="col left">
                  <h4>{d.compareLeft.title}</h4>
                  <ul>{d.compareLeft.points.map((p: string) => <li>{p}</li>)}</ul>
                </div>
                <div class="col right">
                  <h4>{d.compareRight.title}</h4>
                  <ul>{d.compareRight.points.map((p: string) => <li>{p}</li>)}</ul>
                </div>
              </div>
            </div>
            <p class="d-caption" data-reveal>{d.diagramCaption}</p>
          </div>

          <div class="diagram">
            <span class="d-title">{d.diagramTitle}</span>
            <div class="af" data-fig style={`aspect-ratio:${W} / ${H};--ar:${W / H}`}>
              <Picture
                src={figure}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                widths={[600, 900, W]}
                sizes="(max-width: 980px) 420px, 560px"
                alt=""
                loading="lazy"
                decoding="async"
                class="af-img"
              />
              <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" class="svg" role="img" aria-labelledby="af-title">
                <title id="af-title">{d.figureTitle}</title>
                <g class="chain">
                  {segs.map((s, i) => (
                    <path class="seg" data-a={s.a} data-b={s.b} pathLength="1" d={s.d} style={`--d:${300 + i * 220}ms`} />
                  ))}
                </g>
                <g class="dots">
                  {order.map((id) => (
                    <g class="dot" data-id={id}>
                      <circle class="halo" cx={pos[id][0]} cy={pos[id][1]} r="34" />
                      <circle class="core" cx={pos[id][0]} cy={pos[id][1]} r="12" />
                    </g>
                  ))}
                </g>
              </svg>
              {order.map((id) => (
                <button
                  type="button"
                  class="node"
                  data-id={id}
                  style={`left:${((pos[id][0] / W) * 100).toFixed(3)}%;top:${((pos[id][1] / H) * 100).toFixed(3)}%`}
                  aria-pressed="false"
                  aria-label={regionMap[id]?.label}
                >
                  <span class="lab" aria-hidden="true">{regionMap[id]?.label}</span>
                </button>
              ))}
            </div>
            <p class="caption" aria-live="polite" data-caption>{first.caption}</p>
            <ul class="chips" aria-label="Symptoms">
              {d.symptoms.map((s: any) => (
                <li><button type="button" class="chip" data-symptom={s.id} aria-pressed="false">{s.label}</button></li>
              ))}
            </ul>
            <p class="hint">{d.diagramHint}</p>
          </div>
        </div>
      </Collapse>
    </div>
    <script type="application/json" id="approach-data" set:html={JSON.stringify({ regions: d.regions, symptoms: d.symptoms, order })}></script>
  </section>
)}

<script>
  const root = document.querySelector<HTMLElement>('[data-approach]');
  if (root) {
    const data = JSON.parse(document.getElementById('approach-data')!.textContent || '{}');
    const fig = root.querySelector<HTMLElement>('[data-fig]')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const nodes = [...fig.querySelectorAll<HTMLElement>('.node')];
    const dots = [...fig.querySelectorAll<SVGGElement>('.dot')];
    const segs = [...fig.querySelectorAll<SVGPathElement>('.seg')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    const symptoms: any[] = data.symptoms;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;

    const select = (symptomId: string) => {
      const s = symptoms.find((x) => x.id === symptomId);
      if (!s) return;
      const set = new Set<string>(s.nodes);
      nodes.forEach((n) => {
        n.classList.toggle('on', set.has(n.dataset.id!));
        n.setAttribute('aria-pressed', String(set.has(n.dataset.id!)));
      });
      dots.forEach((g) => g.classList.toggle('on', set.has(g.dataset.id!)));
      // light the stretch between consecutive active nodes
      segs.forEach((p) => p.classList.toggle('hot', set.has(p.dataset.a!) && set.has(p.dataset.b!)));
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.symptom === symptomId)));
      caption.textContent = s.caption;
    };

    const stopCycle = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const interact = (id: string) => { stopCycle(); select(id); };
    const symptomForNode = (nodeId: string) => data.regions.find((r: any) => r.id === nodeId)?.symptom;

    nodes.forEach((n) => {
      n.addEventListener('click', () => interact(symptomForNode(n.dataset.id!)));
      n.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') interact(symptomForNode(n.dataset.id!)); });
      n.addEventListener('focus', () => interact(symptomForNode(n.dataset.id!)));
    });
    chips.forEach((c) => c.addEventListener('click', () => interact(c.dataset.symptom!)));

    // Default state: first symptom (Neck tension). Cycles slowly while in view until the visitor interacts.
    select(symptoms[0].id);
    if (!reduce && 'IntersectionObserver' in window) {
      let i = 0;
      const start = () => {
        if (timer) return;
        timer = window.setInterval(() => { i = (i + 1) % symptoms.length; select(symptoms[i].id); }, 4800);
      };
      new IntersectionObserver((e) => {
        const seen = e[0].isIntersecting;
        if (seen) fig.classList.add('in');
        if (seen && timer === undefined && !fig.dataset.touched) start();
        else if (!seen && timer) { clearInterval(timer); timer = undefined; }
      }, { threshold: 0.35 }).observe(fig);
      const touch = () => { fig.dataset.touched = '1'; stopCycle(); };
      fig.addEventListener('pointerdown', touch);
      root.querySelector('.chips')!.addEventListener('pointerdown', touch);
      fig.addEventListener('focusin', touch);
      root.querySelector('.chips')!.addEventListener('focusin', touch);
    } else {
      fig.classList.add('in');
    }
  }
</script>

<style>
  .approach { background: var(--charcoal); color: var(--cream); }
  .grid { display: grid; grid-template-columns: 1.1fr 0.9fr; column-gap: clamp(40px, 6vw, 90px); align-items: center; margin-top: 8px; }
  h2 { font-size: clamp(30px, 4vw, 46px); color: var(--cream); max-width: 22ch; }
  .body { color: var(--cream); opacity: .88; font-size: 18px; line-height: 1.7; margin-top: 22px; max-width: 540px; }
  .body-col { align-self: start; }
  .diagram { display: flex; flex-direction: column; align-items: center; }
  .d-title { font-family: var(--font-display); font-style: italic; font-size: 18px; margin-bottom: 18px; }
  .d-caption { margin-top: 32px; font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--cream-muted); max-width: 480px; }

  /* ---- figure: image + overlay share ONE box, sized by the image's own ratio ---- */
  .af { position: relative; width: min(100%, 560px, calc(80vh * var(--ar))); isolation: isolate; }
  .af::before { content: ''; position: absolute; inset: -6% -10%; z-index: -1; pointer-events: none; background: radial-gradient(ellipse at 50% 46%, rgba(242, 236, 221, 0.07), transparent 62%); }
  .af :global(.af-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; display: block;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 13%, #000 87%, transparent), linear-gradient(to bottom, transparent, #000 3%, #000 93%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 13%, #000 87%, transparent), linear-gradient(to bottom, transparent, #000 3%, #000 93%, transparent);
    mask-composite: intersect; }
  .svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .svg path { fill: none; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; vector-effect: non-scaling-stroke; stroke: var(--sage); stroke-opacity: .6; stroke-width: 2; transition: stroke .35s ease, stroke-opacity .35s ease, stroke-width .35s ease, filter .35s ease; }
  .svg path.hot { stroke: var(--cream); stroke-opacity: 1; stroke-width: 3; filter: drop-shadow(0 0 5px rgba(242, 236, 221, 0.65)); }
  .dot .core { fill: var(--sage); fill-opacity: .8; transition: fill .35s ease, fill-opacity .35s ease; }
  .dot .halo { fill: var(--cream); opacity: 0; transform-box: fill-box; transform-origin: center; transition: opacity .35s ease; }
  .dot.on .core { fill: var(--cream); fill-opacity: 1; }
  .dot.on .halo { opacity: .28; animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { transform: scale(.75); opacity: .3; } 50% { transform: scale(1.2); opacity: .1; } }

  /* draw-in when scrolled into view: line first, then nodes */
  :global(.js) .af:not(.in) .svg path { stroke-dashoffset: 1; }
  :global(.js) .af:not(.in) .dots { opacity: 0; }
  .dots { transition: opacity .8s ease 1.6s; }
  .af.in .svg path { animation: draw 1.2s var(--ease) both; animation-delay: var(--d, 0ms); }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  .node { position: absolute; width: 44px; height: 44px; margin: -22px 0 0 -22px; padding: 0; border: 0; border-radius: 50%; background: transparent; }
  .node:focus-visible { outline: 2px solid var(--cream); outline-offset: 0; }
  .lab { position: absolute; left: calc(50% + 14px); top: 50%; transform: translateY(calc(-50% + var(--ly, 0px))); white-space: nowrap; font-size: 12.5px; line-height: 1.3; background: rgba(34, 30, 25, 0.92); color: var(--cream); padding: 3px 9px; border: 1px solid rgba(242, 236, 221, 0.25); border-radius: 20px; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
  /* nudge labels of close neighbours apart so they never overlap, even at 320px */
  .node[data-id='jaw'] { --ly: -9px; }
  .node[data-id='neck'] { --ly: 7px; }
  .node.on .lab { opacity: 1; }

  .caption { min-height: 4.4em; margin-top: 20px; text-align: center; max-width: 340px; font-family: var(--font-display); font-style: italic; font-size: 19px; line-height: 1.4; color: var(--cream); }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 12px; list-style: none; padding: 0; }
  .chip { min-height: 44px; padding: 0 18px; border-radius: 30px; border: 1px solid rgba(242, 236, 221, 0.4); background: transparent; color: var(--cream); font-size: 14px; transition: background .3s ease, color .3s ease, border-color .3s ease; }
  .chip:hover { border-color: var(--cream); }
  .chip[aria-pressed='true'] { background: var(--cream); color: var(--charcoal); border-color: var(--cream); }
  .hint { margin-top: 12px; font-size: 13px; color: var(--cream-muted); text-align: center; }

  /* ---- comparison ---- */
  .compare { margin-top: 40px; }
  .cmp-h { font-size: 15px; font-family: var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--cream-muted); font-weight: 600; margin-bottom: 14px; }
  .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .col { padding: 20px 20px 22px; border: 1px solid rgba(242, 236, 221, 0.18); border-radius: var(--radius); }
  .col h4 { font-family: var(--font-display); font-size: 19px; font-weight: 500; margin-bottom: 12px; }
  .col ul { display: flex; flex-direction: column; gap: 10px; }
  .col li { font-size: 14.5px; line-height: 1.5; padding-left: 18px; position: relative; color: var(--cream); opacity: .85; }
  .col li::before { content: ''; position: absolute; left: 0; top: 9px; width: 8px; height: 1.5px; background: currentColor; opacity: .6; }
  .col.left h4 { color: var(--cream-muted); font-style: italic; }
  .col.right { background: rgba(143, 160, 124, 0.12); border-color: rgba(143, 160, 124, 0.55); }
  .col.right li { opacity: 1; }
  .col.right li::before { background: var(--sage); opacity: 1; height: 2px; }

  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .diagram { order: -1; margin-bottom: 36px; }
    .af { width: min(100%, 420px); }
  }
  @media (max-width: 560px) { .cmp { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    .af.in .svg path { animation: none; }
    :global(.js) .af:not(.in) .svg path { stroke-dashoffset: 0; }
    :global(.js) .af:not(.in) .dots { opacity: 1; }
    .dots { transition: none; }
    .dot.on .halo { animation: none; opacity: .25; }
    .svg path, .dot .core, .dot .halo, .lab, .chip { transition: none; }
  }
</style>
