---
import OfferCard from './OfferCard.astro';
import { getContent } from '../lib/content';
const d = await getContent('offers');
const contact = await getContent('contact');
---
{d.visible && (
  <section id="work-with-me" class="offers band">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{d.eyebrow}</span>
      <h2 class="h2" data-reveal data-reveal-delay="80">{d.heading}</h2>
      <span class="rule"></span>
      <div class:list={['grid', { single: d.items.length === 1 }]}>
        {d.items.map((o: any, i: number) => <OfferCard offer={o} bookingUrl={contact.bookingUrl} delay={i * 100} />)}
      </div>

      {d.faqs.length > 0 && (
        <div class="faq" data-faq data-reveal>
          <h3>{d.faqHeading}</h3>
          <div class="items">
            {d.faqs.map((f: any, i: number) => (
              <div class="item">
                <h4>
                  <button type="button" id={`faq-q-${i}`} aria-expanded="false" aria-controls={`faq-a-${i}`}>
                    <span>{f.question}</span><span class="pm" aria-hidden="true"></span>
                  </button>
                </h4>
                <div class="a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}><div class="a-in"><p>{f.answer}</p></div></div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<script>
  // One open at a time; height animates via the grid-rows trick (see CSS).
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.item')];
    items.forEach((it) => {
      const b = it.querySelector('button')!;
      b.addEventListener('click', () => {
        const willOpen = b.getAttribute('aria-expanded') !== 'true';
        items.forEach((o) => {
          o.classList.remove('open');
          o.querySelector('button')!.setAttribute('aria-expanded', 'false');
        });
        if (willOpen) { it.classList.add('open'); b.setAttribute('aria-expanded', 'true'); }
      });
    });
  });
</script>

<style>
  .offers { background: var(--sand); }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 44px; align-items: stretch; }
  .grid.single { grid-template-columns: minmax(0, 640px); }
  .faq { margin-top: clamp(56px, 7vw, 88px); }
  .faq h3 { font-size: clamp(24px, 3vw, 30px); margin-bottom: 20px; }
  .items { border-top: 1px solid var(--stone); }
  .item { border-bottom: 1px solid var(--stone); }
  .item h4 { margin: 0; font-family: inherit; font-weight: inherit; letter-spacing: 0; }
  .item button { display: flex; justify-content: space-between; align-items: center; gap: 20px; width: 100%; min-height: 60px; padding: 14px 0; background: transparent; border: 0; text-align: left; font-size: 17px; font-weight: 500; color: var(--ink); }
  .pm { position: relative; width: 14px; height: 14px; flex: none; }
  .pm::before, .pm::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--olive); transition: transform .35s var(--ease); }
  .pm::after { transform: rotate(90deg); }
  .item.open .pm::after { transform: rotate(0); }
  .a { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows .4s var(--ease), visibility 0s .4s; }
  .item.open .a { grid-template-rows: 1fr; visibility: visible; transition: grid-template-rows .4s var(--ease), visibility 0s; }
  .a-in { overflow: hidden; min-height: 0; }
  .a p { padding: 0 0 22px; max-width: 90ch; font-size: 16px; line-height: 1.65; color: var(--ink-muted); }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .a, .pm::before, .pm::after { transition: none; } }
</style>
