---
import { getContent } from '../lib/content';
import { formEndpoints } from '../lib/forms';
const d = await getContent('freeResource');
---
{d.visible && (
  <section id="resource" class="resource band">
    <div class="wrap grid">
      <div>
        <span class="eyebrow eyebrow-dark">{d.eyebrow}</span>
        <h2>{d.heading}</h2>
        <div class="copy">{d.paragraphs.map((p: string) => <p>{p}</p>)}</div>
      </div>
      <form class="form-dark" data-form data-success={d.successMessage} action={formEndpoints.freeResource || undefined} method="post">
        <div class="fields">
          <div class="field">
            <label for="res-name">{d.nameLabel}</label>
            <input id="res-name" name="first_name" type="text" autocomplete="given-name" placeholder={d.namePlaceholder} required />
          </div>
          <div class="field">
            <label for="res-email">{d.emailLabel}</label>
            <input id="res-email" name="email" type="email" autocomplete="email" placeholder={d.emailPlaceholder} required />
          </div>
          <button type="submit" class="btn btn-primary">{d.buttonLabel}</button>
        </div>
        <p class="fine">{d.finePrint}</p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
)}

<style>
  .resource { background: var(--olive-deep); color: var(--cream); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  h2 { font-size: clamp(28px, 3.6vw, 42px); color: var(--cream); }
  .copy p { color: var(--cream-muted); font-size: 17px; line-height: 1.7; margin-top: 20px; max-width: 460px; }
  .fields { display: flex; flex-direction: column; gap: 18px; margin-top: 8px; }
  form .btn { width: 100%; }
  .fine { font-size: 13px; color: rgba(242, 236, 221, 0.75); margin-top: 16px; }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr; } }
</style>
