---
import { getContent } from '../lib/content';
import { formEndpoints } from '../lib/forms';
const d = await getContent('freeResource');
---
{d.visible && (
  <section id="resource" class="resource band">
    <div class="wrap grid">
      <div class="mock-col" data-reveal>
        <div class="mock" role="img" aria-label={`${d.guideTitle} - ${d.guideSubtitle}`}>
          <span class="page p3"></span>
          <span class="page p2"></span>
          <div class="cover">
            <span class="brand">{d.guideBrand}</span>
            <svg viewBox="0 0 120 70" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 40c14-22 28-22 40 0s26 22 38 0 22-14 34-6"/><path d="M4 50c14-22 28-22 40 0s26 22 38 0 22-14 34-6" opacity=".5"/><path d="M4 30c14-22 28-22 40 0s26 22 38 0 22-14 34-6" opacity=".5"/>
            </svg>
            <span class="gt">{d.guideTitle}</span>
            <span class="gs">{d.guideSubtitle}</span>
            <span class="gp">{d.guidePages}</span>
          </div>
        </div>
      </div>
      <div class="form-col">
        <span class="eyebrow" data-reveal>{d.eyebrow}</span>
        <h2 data-reveal data-reveal-delay="60">{d.heading}</h2>
        <div class="copy" data-reveal data-reveal-delay="100">{d.paragraphs.map((p: string) => <p>{p}</p>)}</div>
        <form data-form data-success={d.successMessage} action={formEndpoints.freeResource || undefined} method="post" data-reveal data-reveal-delay="140">
          <div class="fields">
            <div class="field">
              <label for="res-name">{d.nameLabel}</label>
              <input id="res-name" name="first_name" type="text" autocomplete="given-name" placeholder={d.namePlaceholder} required />
            </div>
            <div class="field">
              <label for="res-email">{d.emailLabel}</label>
              <input id="res-email" name="email" type="email" autocomplete="email" placeholder={d.emailPlaceholder} required />
            </div>
            <button type="submit" class="btn btn-primary btn-arrow">{d.buttonLabel}</button>
          </div>
          <p class="fine">{d.finePrint}</p>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
)}

<style>
  .resource { background: var(--sand); }
  .grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(36px, 6vw, 96px); align-items: center; }
  h2 { font-size: clamp(28px, 3.6vw, 42px); }
  .copy p { color: var(--ink-muted); font-size: 17px; line-height: 1.7; margin-top: 18px; max-width: 520px; }
  form { margin-top: 28px; max-width: 440px; }
  .fields { display: flex; flex-direction: column; gap: 18px; }
  form .btn { width: 100%; }
  .fine { font-size: 13px; color: var(--ink-muted); margin-top: 14px; }

  /* guide mockup: stacked pages + a cover, pure CSS/SVG placeholder */
  .mock-col { display: flex; justify-content: center; }
  .mock { position: relative; width: min(280px, 70vw); aspect-ratio: 3 / 4; transform: rotate(-3deg); }
  .page { position: absolute; inset: 0; background: var(--white); border: 1px solid var(--stone-line); box-shadow: 0 18px 30px -22px rgba(34, 30, 25, 0.55); }
  .p2 { transform: translate(14px, 8px) rotate(3deg); background: var(--bone); }
  .p3 { transform: translate(28px, 14px) rotate(6deg); background: var(--sand); border-color: var(--stone); }
  .cover { position: relative; height: 100%; padding: 26px 24px; background: var(--olive); color: var(--cream); display: flex; flex-direction: column; box-shadow: 0 24px 40px -22px rgba(34, 30, 25, 0.6); }
  .brand { font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
  .cover svg { width: 78%; margin: auto 0; color: var(--sage); }
  .gt { font-family: var(--font-display); font-size: 30px; line-height: 1.1; }
  .gs { font-size: 13px; margin-top: 8px; opacity: .9; }
  .gp { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; margin-top: 18px; opacity: .85; }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .mock-col { order: 2; margin-top: 20px; }
    .form-col { order: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .mock { transform: none; } }
</style>
