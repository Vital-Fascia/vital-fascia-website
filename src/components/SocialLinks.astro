---
import { Image } from 'astro:assets';
import instagram from '../assets/icons/instagram.png';
import tiktok from '../assets/icons/tiktok.png';
import whatsapp from '../assets/icons/whatsapp.png';
import gmail from '../assets/icons/gmail.png';
import { getContent } from '../lib/content';

interface Props { class?: string; size?: number }
const { class: className, size = 44 } = Astro.props;
const c = await getContent('contact');

// Facebook is intentionally left out for now. Links come from contact.yaml; empty = hidden.
const all = [
  { name: 'Instagram', src: instagram, href: c.instagramUrl },
  { name: 'TikTok', src: tiktok, href: c.tiktokUrl },
  { name: 'WhatsApp', src: whatsapp, href: c.whatsappUrl },
  { name: 'Email', src: gmail, href: c.email ? `mailto:${c.email}` : '' },
];
const links = all.filter((l) => l.href);
---
<ul class:list={['socials', className]} aria-label="Social links">
  {links.map((l) => (
    <li>
      <a href={l.href} aria-label={l.name} title={l.name} target={l.name === 'Email' ? undefined : '_blank'} rel={l.name === 'Email' ? undefined : 'noopener'}>
        <Image src={l.src} alt="" width={size} height={size} densities={[1, 2]} />
      </a>
    </li>
  ))}
</ul>

<style>
  .socials { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  a { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; }
  a :global(img) { width: 36px; height: 36px; object-fit: contain; transition: transform .35s var(--ease), filter .35s ease; }
  /* grow + a small rotate on hover/focus, only where hover exists */
  @media (hover: hover) {
    a:hover :global(img) { transform: scale(1.18) rotate(-8deg); }
  }
  a:focus-visible :global(img) { transform: scale(1.18) rotate(-8deg); }
  @media (prefers-reduced-motion: reduce) {
    a :global(img) { transition: none; }
    a:hover :global(img), a:focus-visible :global(img) { transform: none; }
  }
</style>
