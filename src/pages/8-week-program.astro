---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../lib/content';
import { formEndpoints } from '../lib/forms';
const d = await getContent('programPage');
---
<BaseLayout page="program">
  <section class="hero">
    <div class="wrap">
      <span class="badge">{d.badge}</span>
      <h1>{d.heading}</h1>
      <p class="lede intro">{d.intro}</p>
      <a class="btn btn-primary cta" href={d.primaryButton.href}>{d.primaryButton.label}</a>
    </div>
  </section>

  <section class="band includes">
    <div class="wrap">
      <h2 class="h2">{d.includesHeading}</h2>
      <span class="rule"></span>
      <ul class="grid">
        {d.includes.map((i: any) => <li class="card"><h3>{i.title}</h3><p>{i.description}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="band-tight for-who">
    <div class="wrap two">
      <div>
        <h2 class="h2">{d.forWhoHeading}</h2>
        <span class="rule"></span>
        <p class="lede intro">{d.forWhoText}</p>
      </div>
      <div>
        <h2 class="h2">{d.detailsHeading}</h2>
        <span class="rule"></span>
        <dl>
          {d.details.map((x: any) => <div class="row"><dt>{x.label}</dt><dd>{x.value}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section id="waitlist" class="band waitlist">
    <div class="wrap two">
      <div>
        <h2>{d.waitlistHeading}</h2>
        <p class="wl-text">{d.waitlistText}</p>
      </div>
      <form class="form-dark" data-form data-success={d.successMessage} action={formEndpoints.programWaitlist || undefined} method="post">
        <div class="fields">
          <div class="field"><label for="wl-name">{d.nameLabel}</label><input id="wl-name" name="first_name" type="text" autocomplete="given-name" required /></div>
          <div class="field"><label for="wl-email">{d.emailLabel}</label><input id="wl-email" name="email" type="email" autocomplete="email" required /></div>
          <button type="submit" class="btn btn-primary">{d.buttonLabel}</button>
        </div>
        <p class="fine">{d.finePrint}</p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: calc(var(--header-h) + clamp(48px, 7vw, 96px)); padding-bottom: clamp(48px, 6vw, 80px); }
  .badge { display: inline-block; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 600; color: var(--olive); border: 1px dashed var(--stone); padding: 6px 12px; margin-bottom: 22px; }
  h1 { font-size: clamp(40px, 5.6vw, 68px); line-height: 1.08; max-width: 800px; }
  .intro { margin-top: 22px; }
  .cta { margin-top: 36px; }
  .includes { background: var(--sand); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 44px; }
  .card { background: var(--bone); border: 1px solid var(--stone-line); padding: 28px 24px; }
  .card h3 { font-size: 19px; margin-bottom: 8px; }
  .card p { font-size: 15px; line-height: 1.55; color: var(--ink-muted); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  dl { margin: 28px 0 0; }
  .row { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--stone-line); }
  dt { color: var(--ink-muted); font-size: 15px; }
  dd { margin: 0; font-weight: 600; font-size: 15px; text-align: right; }
  .waitlist { background: var(--olive-deep); color: var(--cream); }
  .waitlist h2 { color: var(--cream); font-size: clamp(28px, 3.6vw, 42px); }
  .wl-text { color: var(--cream-muted); font-size: 17px; line-height: 1.7; margin-top: 20px; max-width: 460px; }
  .fields { display: flex; flex-direction: column; gap: 18px; }
  form .btn { width: 100%; }
  .fine { font-size: 13px; color: rgba(242, 236, 221, 0.75); margin-top: 16px; }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr; } .two { grid-template-columns: 1fr; } }
</style>
