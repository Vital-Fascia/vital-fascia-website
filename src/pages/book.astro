---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../lib/content';
const d = await getContent('bookingPage');
const c = await getContent('contact');
const summary = (loc: any) => loc.hours.map((h: any) => `${h.days} ${h.time}`).join(', ');
---
<BaseLayout page="book">
  <section class="band book">
    <div class="wrap">
      <span class="eyebrow">{d.eyebrow}</span>
      <h1>{d.heading}</h1>
      <span class="rule"></span>
      <p class="lede intro">{d.intro}</p>

      <div class="locs" data-locs>
        {c.locations.map((loc: any) => (
          <article class="loc" data-loc={loc.id} data-name={loc.name} data-hours={summary(loc)} data-embed={loc.embedUrl}>
            <span class="tick" aria-hidden="true"></span>
            <h2>{loc.name}</h2>
            <p class="addr">{loc.addressLines.map((line: string, i: number) => <>{i > 0 && <br />}{line}</>)}</p>
            <dl class="hours" aria-label={`${c.hoursHeading} - ${loc.name}`}>
              {loc.hours.map((h: any) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
            </dl>
            {loc.mapEmbedUrl && (
              <details class="map-d">
                <summary>{d.mapLabel}</summary>
                <div class="map">
                  <iframe src={loc.mapEmbedUrl} title={`Map of ${loc.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
                {loc.mapLinkUrl && <a class="underline" href={loc.mapLinkUrl} target="_blank" rel="noopener">{d.directionsLabel}</a>}
              </details>
            )}
            <a class="btn btn-primary select" href={loc.bookingUrl} data-select data-select-label={d.selectLabel} data-selected-label={d.selectedLabel}>{d.selectLabel}</a>
          </article>
        ))}
      </div>

      <section id="booking" class="booking" aria-labelledby="booking-title" data-booking data-loading-text={d.loadingText}>
        <div class="b-bar">
          <div>
            <h2 id="booking-title" data-title data-prefix={d.bookingHeadingPrefix}>{d.bookingHeadingEmpty}</h2>
            <p class="b-hours" data-hours></p>
          </div>
          <button type="button" class="change" data-change hidden>{d.changeLabel}</button>
        </div>
        <div class="b-stage">
          <p class="b-msg" data-msg role="status">{d.emptyText}</p>
          <div class="b-frame" data-frame hidden></div>
          <p class="b-fallback" data-fallback hidden>
            <a class="underline" href="#" target="_blank" rel="noopener" data-fallback-link>{d.fallbackText}</a>
          </p>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-booking]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-loc]')];
  const title = root.querySelector<HTMLElement>('[data-title]')!;
  const hoursEl = root.querySelector<HTMLElement>('[data-hours]')!;
  const msg = root.querySelector<HTMLElement>('[data-msg]')!;
  const frameBox = root.querySelector<HTMLElement>('[data-frame]')!;
  const change = root.querySelector<HTMLButtonElement>('[data-change]')!;
  const fallback = root.querySelector<HTMLElement>('[data-fallback]')!;
  const fallbackLink = root.querySelector<HTMLAnchorElement>('[data-fallback-link]')!;
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = '';
  let iframe: HTMLIFrameElement | null = null;

  // Cliniko tells the page how tall the form is, so there is no inner scrollbar.
  window.addEventListener('message', (e) => {
    if (typeof e.data !== 'string' || !iframe) return;
    if (e.data.includes('cliniko-bookings-resize')) iframe.style.height = `${Number(e.data.split(':')[1])}px`;
    if (e.data.includes('cliniko-bookings-page')) iframe.scrollIntoView();
  });

  const show = (id: string, scroll: boolean) => {
    const card = cards.find((x) => x.dataset.loc === id);
    if (!card || id === current) { if (card && scroll) root.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth' }); return; }
    current = id;
    cards.forEach((x) => {
      const on = x === card;
      x.classList.toggle('on', on);
      x.classList.toggle('dim', !on);
      const b = x.querySelector<HTMLAnchorElement>('[data-select]')!;
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? b.dataset.selectedLabel! : b.dataset.selectLabel!;
    });
    title.textContent = `${title.dataset.prefix} ${card.dataset.name}`;
    hoursEl.textContent = card.dataset.hours!;
    change.hidden = false;
    msg.hidden = false;
    msg.textContent = root.dataset.loadingText!;
    frameBox.hidden = true;
    frameBox.replaceChildren();
    fallback.hidden = false;
    fallbackLink.href = card.querySelector<HTMLAnchorElement>('[data-select]')!.href;
    iframe = document.createElement('iframe');
    iframe.title = title.textContent;
    iframe.setAttribute('allow', 'payment');
    iframe.style.height = '900px';
    iframe.addEventListener('load', () => { msg.hidden = true; frameBox.hidden = false; });
    iframe.src = card.dataset.embed!;
    frameBox.append(iframe);
    frameBox.hidden = false;
    frameBox.classList.add('loading');
    iframe.addEventListener('load', () => frameBox.classList.remove('loading'));
    history.replaceState(null, '', `#${id}`);
    if (scroll) root.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth' });
  };

  cards.forEach((card) => {
    const btn = card.querySelector<HTMLAnchorElement>('[data-select]')!;
    btn.setAttribute('role', 'button');
    btn.setAttribute('aria-pressed', 'false');
    btn.removeAttribute('target');
    btn.addEventListener('click', (e) => { e.preventDefault(); show(card.dataset.loc!, true); });
    // the whole panel is a target, except its map and links
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('details, a, button')) return;
      show(card.dataset.loc!, true);
    });
  });
  change.addEventListener('click', () => document.querySelector('[data-locs]')!.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth' }));

  const fromHash = () => {
    const id = location.hash.slice(1);
    if (id && cards.some((x) => x.dataset.loc === id)) show(id, true);
  };
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>

<style>
  .book { padding-top: calc(var(--header-h) + clamp(40px, 6vw, 80px)); background: var(--bone); }
  h1 { font-size: clamp(34px, 5vw, 52px); }
  .intro { margin-top: 18px; max-width: 60ch; }
  .underline { color: var(--olive); text-decoration: underline; text-underline-offset: 3px; font-size: 14.5px; }

  .locs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 40px; align-items: stretch; }
  .loc { position: relative; display: flex; flex-direction: column; background: var(--white); border: 1.5px solid var(--stone-line); border-radius: var(--radius); padding: 32px 30px 30px; cursor: pointer; transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .25s ease, background .25s ease, opacity .25s ease; }
  .loc:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); border-color: var(--olive); }
  .loc:focus-within { border-color: var(--olive); }
  .loc.on { border-color: var(--olive); background: var(--sand); box-shadow: inset 0 0 0 1.5px var(--olive); }
  .loc.dim { opacity: .72; }
  .loc.dim:hover { opacity: 1; }
  .tick { position: absolute; top: 18px; right: 18px; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--stone); transition: background .25s ease, border-color .25s ease; }
  .loc.on .tick { background: var(--olive); border-color: var(--olive); }
  .loc.on .tick::after { content: ''; position: absolute; left: 8px; top: 4px; width: 7px; height: 12px; border: solid var(--cream); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .loc h2 { font-size: 28px; padding-right: 40px; }
  .addr { margin-top: 10px; color: var(--ink-muted); font-size: 16px; line-height: 1.6; }
  .hours { margin: 18px 0 0; border-top: 1px solid var(--stone-line); }
  .hours div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--stone-line); font-size: 15px; }
  .hours dt { color: var(--ink-muted); }
  .hours dd { margin: 0; font-weight: 500; text-align: right; }
  .map-d { margin-top: 16px; }
  .map-d summary { cursor: pointer; font-size: 14.5px; color: var(--olive); font-weight: 500; min-height: 32px; display: flex; align-items: center; }
  .map { margin: 12px 0; aspect-ratio: 16/10; border: 4px solid var(--olive); border-radius: var(--radius); overflow: hidden; }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; filter: grayscale(.35) contrast(.95); }
  .select { margin-top: auto; align-self: flex-start; }
  .map-d + .select, .hours + .select { margin-top: 24px; }
  .loc.on .select { background: var(--olive-dark); }

  /* the booking area keeps the same place and a reserved height whatever state it is in */
  .booking { margin-top: 48px; scroll-margin-top: calc(var(--header-h) + 12px); }
  .b-bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding-bottom: 14px; border-bottom: 2px solid var(--olive); min-height: 72px; }
  .b-bar h2 { font-size: clamp(22px, 3vw, 30px); }
  .b-hours { margin-top: 4px; color: var(--ink-muted); font-size: 14.5px; min-height: 1.4em; }
  .change { background: none; border: 0; color: var(--olive); text-decoration: underline; text-underline-offset: 3px; font-size: 15px; min-height: 44px; padding: 0 4px; cursor: pointer; }
  .change[hidden] { display: none; }
  .b-stage { position: relative; min-height: 520px; background: var(--white); border: 1px solid var(--stone-line); border-top: 0; }
  .b-msg { padding: 40px 28px; text-align: center; color: var(--ink-muted); }
  .b-msg[hidden], .b-frame[hidden], .b-fallback[hidden] { display: none; }
  .b-frame :global(iframe) { display: block; width: 100%; border: 0; }
  .b-frame.loading { visibility: hidden; position: absolute; inset: 0; }
  .b-fallback { padding: 14px 20px; border-top: 1px solid var(--stone-line); text-align: center; }

  @media (max-width: 760px) {
    .locs { grid-template-columns: 1fr; }
    .loc { padding: 26px 22px 24px; }
    .select { align-self: stretch; text-align: center; }
    .b-stage { min-height: 420px; }
  }
  @media (prefers-reduced-motion: reduce) { .loc { transition: none; } .loc:hover { transform: none; } }
</style>
