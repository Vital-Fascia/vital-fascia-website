---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { getContent } from '../lib/content';
import { getLegalLinks } from '../lib/legal-links';
const sitemapPage = await getContent('sitemapPage');
const legalLinks = await getLegalLinks();
const site = await getContent('site');
const contact = await getContent('contact');
const groups = [
  { heading: 'Pages', links: [{ label: 'Home', href: '/' }, ...site.navLinks.map((l: any) => ({ label: l.label, href: l.href })), { label: contact.bookingLabel, href: '/book' }] },
  { heading: 'Legal', links: legalLinks },
];
---
<BaseLayout page="legal" title={sitemapPage.title} description={sitemapPage.intro}>
  <LegalPage title={sitemapPage.title} intro={sitemapPage.intro}>
    {groups.map((g) => (
      <div class="grp">
        <h2>{g.heading}</h2>
        <ul>{g.links.map((l: any) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}
  </LegalPage>
</BaseLayout>

<style>
  .grp { margin-top: 36px; }
  .grp h2 { font-size: 24px; }
  ul { margin-top: 10px; display: flex; flex-direction: column; }
  li a { display: inline-block; padding: 8px 0; font-size: 17px; color: var(--olive); text-decoration: underline; text-underline-offset: 3px; }
</style>
