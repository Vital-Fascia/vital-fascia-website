---
// PRIVATE guide for Alex (not linked anywhere, noindex, excluded from the sitemap; see astro.config.mjs and public/_headers).
// Not site content, so (like admin/email-previews) the copy lives in this file rather than src/content/*.yaml.
// Facts about each repo were read from its GitHub page on 2026-11-11. Re-check before relying on them.
import '../../styles/global.css';

type Rating = 'yes' | 'part' | 'no';
const checks = ['Cuts ums, pauses, retakes', 'Captions', 'Zoom punch-ins', 'Sound effects', 'Transitions', 'Saved brand / theme', 'Free, no paid keys'] as const;

const repos: {
  name: string; url: string; stats: string; pick?: string; summary: string; pros: string[]; catches: string[]; fit: Rating[];
}[] = [
  {
    name: 'Vedit', url: 'https://github.com/onetwothird/Vedit', stats: '2 stars · MIT licence · updated 7 Nov 2026',
    pick: 'Start here',
    summary: 'A command-line editor with a Claude skill on top, built for creators. Cuts dead air, ums and flubbed takes (keeping the last take), adds word-by-word captions, and has a Reels preset.',
    pros: ['Saved brand kit (brand.json): font, highlight colour, logo, intro/outro, music, colour look. This is how every reel looks the same.', 'Free local transcription (Whisper), so no paid keys needed.', 'Runs natively on Windows (PowerShell), with install steps in its docs.', 'Built-in whoosh / ding / pop sound effects and alternating punch-in zooms.'],
    catches: ['Very young project, tiny community.', 'Crossfade and whip transitions are on its roadmap, not finished.', 'One-time setup in PowerShell (the prompt above has Claude do it for you).'],
    fit: ['yes', 'yes', 'yes', 'yes', 'part', 'yes', 'yes'],
  },
  {
    name: 'talking-head-editor', url: 'https://github.com/griffinwooldridge/talking-head-editor', stats: '10 stars · MIT · updated 27 Oct 2026',
    pick: 'Not for Windows',
    summary: 'Cleans up the voice, makes tight cuts, tracks your face for vertical framing, adds word-timed captions and animated graphics, with a library of fancy transitions.',
    pros: ['Richest transitions and motion graphics of the free options.', 'No API keys needed.', 'Voice clean-up built in.'],
    catches: ['No saved style file, so it restyles each run (less consistent).', 'Mac and Linux only: it does not run on Windows, so it is not an option for your PC.', 'Sound effects not mentioned.'],
    fit: ['yes', 'yes', 'part', 'no', 'yes', 'part', 'yes'],
  },
  {
    name: 'tenfoldmarc/video-edit-skill', url: 'https://github.com/tenfoldmarc/video-edit-skill', stats: '138 stars · no licence file · updated 15 Oct 2026',
    summary: 'Turns phone clips into a finished Instagram reel: picks the best take of each line, puts words behind your head, adds sound effects and animated inserts. Its readme says it works from the Code tab of the Claude desktop app.',
    pros: ['Closest to a one-command "make me a reel" experience.', 'Three ready-made looks.', 'Explicitly supports the Claude desktop app.'],
    catches: ['No licence file, so treat as personal use only: do not copy or share the code.', 'Only three fixed looks, so limited theming.', 'Windows untested by its author.'],
    fit: ['yes', 'yes', 'yes', 'yes', 'no', 'part', 'yes'],
  },
  {
    name: 'video-use (browser-use)', url: 'https://github.com/browser-use/video-use', stats: '30.9k stars · MIT · updated 8 Oct 2026',
    summary: 'The most popular and established. Cuts from the transcript, colour-grades, smooths audio joins and burns in subtitles, with animations via HyperFrames or Remotion.',
    pros: ['Biggest community, so most likely to keep being maintained.', 'Handles longer, messier footage well by working from the transcript.'],
    catches: ['Needs a paid ElevenLabs key for transcription (pay per use).', 'No saved brand file; sound effects and zooms not mentioned.'],
    fit: ['yes', 'yes', 'no', 'no', 'part', 'no', 'no'],
  },
  {
    name: 'video-editing-skill (social-media-skills)', url: 'https://github.com/social-media-skills/video-editing-skill', stats: '1 star · MIT · updated 30 Oct 2026',
    summary: 'Cuts silences, ums and retakes, adds gentle 1.1x punch-ins, levels audio to social-media loudness and writes caption files and chapters.',
    pros: ['Simple and focused. Works on Windows, Mac and Linux.', 'Three editing styles (tight, podcast, YouTube).'],
    catches: ['Brand new with a single commit.', 'No sound effects, transitions or brand file.', 'Its readme promotes a paid posting service (optional).'],
    fit: ['yes', 'yes', 'yes', 'no', 'no', 'no', 'yes'],
  },
];

const setupPrompt = `I want to set up a free AI reel-editing workflow on this Windows PC using the open-source "Vedit" skill (https://github.com/onetwothird/Vedit). I am not technical, so do each step yourself, check that it worked before moving on, and explain any problem in plain English. Ask before anything that deletes files.

1. CHECK AND INSTALL the prerequisites with winget: Python 3.9 or newer (Python.Python.3.12), Git (Git.Git) and FFmpeg (Gyan.FFmpeg). Tell me if I need to close and reopen the app so they are picked up.
2. INSTALL VEDIT: git clone https://github.com/onetwothird/vedit.git into Documents\\vedit, then inside that folder run: pip install -e ".[all]" and then: vedit doctor. Fix anything that is not [ok].
3. LINK THE SKILL so Claude can find it: create the folder $HOME\\.claude\\skills if missing, then create a junction (not a symlink) named vedit pointing at Documents\\vedit.
4. SAFETY CHECK: before using it, skim SKILL.md and the scripts for anything that uploads my files, contacts unknown servers or looks unsafe. Give me a 3-bullet summary. Stop and ask me if anything worries you.
5. CREATE MY WORKSPACE: Documents\\Reels\\Inbox (raw clips go here) and Documents\\Reels\\Done (finished reels).
6. CREATE MY BRAND FILE at $HOME\\.vedit\\brand.json for Vital Fascia (Vedit supports font, highlight colour, logo, intro/outro, music, colour look). Ask me for the font, accent colour, whether I have a logo file, and whether I want music. Do not guess. Use only free-to-use fonts and music.
7. WRITE MY STANDING RULES to Documents\\Reels\\default-prompt.md: vertical 9:16; remove ums, ahs, stutters, long pauses and repeated sentences and keep the best take; default length 30-45 seconds unless my notes say otherwise; word-by-word captions in my brand style; subtle zoom punch-ins on emphasis; a light sound effect only on key points; never cut mid-word; flag anything you are unsure about; save the result in Documents\\Reels\\Done. Tell me that my per-video notes override these rules.
8. FINISH by telling me, in 5 short steps, exactly how to do my first run: copy a clip from my Android phone into Documents\\Reels\\Inbox, open that Reels folder in the Code tab, and ask you to edit it using default-prompt.md and my brand settings. If a clip is already in Inbox, offer to run it now and tell me where the finished file will be.`;

const videos = [
  { id: 'S9Dd8fQHaEo', title: 'Claude Code Video Editing: No Editor Needed (Free Skill)', by: 'Nuno Tavares | Automated Marketer', why: 'Closest to Alex\'s goal: a free skill editing talking-head footage.' },
  { id: 'JjM0MSgwIDI', title: 'Edit TikToks, Reels & Shorts Faster With AI', by: 'Judith Creates', why: 'Reels-focused: filler words, captions, overlays in plain English.' },
  { id: '9e5T7yn1cvk', title: '8 Claude Skills That Edit Your Videos For You', by: 'Darius Reed', why: 'A tour of the free skills from raw cut to captions to graphics.' },
  { id: 'f1Dugj0rIcg', title: 'Claude Code Now Edits My Videos (HyperFrames Studio Tutorial)', by: 'Vito Zhu', why: 'See the "describe the edit, Claude does it" loop in action.' },
  { id: 'Ri9St_A5ZEo', title: 'How to Use HyperFrames (Make Videos from HTML with Claude Code)', by: 'tubemind', why: 'Setup walk-through from inside the Claude desktop app.' },
];

const stages = [
  { n: 1, title: 'Install one skill and edit one clip', when: 'This week', body: 'Paste the setup prompt at the top of this page into the Code tab of the Claude desktop app, then follow the first-run steps. Test on a throwaway 30-second clip. Goal: see the cuts, captions and zooms working once.' },
  { n: 2, title: 'Lock in the look', when: 'Week 2', body: 'Set Vedit\'s brand.json (fonts, colours, logo, music, intro/outro) to match Vital Fascia. Add the free HyperFrames skills for extra caption styles and sound effects. Edit three real reels and note what you would change.' },
  { n: 3, title: 'Dump & run', when: 'Week 3-4', body: 'A small watched-folder script on your PC: drop clips (and an optional notes.txt) into Reels/Inbox. It runs Claude with your default prompt plus the notes, saves the result into Reels/Done and pops up a notification. You check it and post.' },
];

const risks = [
  'These repos are young and mostly have few users. Have someone technical skim the code before installing, and try everything on a throwaway clip first.',
  'Check the licence before reusing anything: one repo above has no licence at all.',
  'Keep client or patient footage and any clinical detail out of third-party services. Prefer the free local options that transcribe on your own PC.',
  'Always watch the result before posting. AI cuts occasionally clip a word or misspell a caption, and health claims in captions still need to be accurate.',
  'Only use music you are licensed to use commercially. The free sound effects bundled with these tools are the safe choice; check the licence before adding any other music.',
];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>AI Reel Editing Guide</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="hero">
      <div class="in">
        <p class="eyebrow-l">Private guide · for Alex</p>
        <h1>Your <em>dump &amp; run</em> reel editor</h1>
        <p class="lede">You record. You drop the clips in a folder. An AI system cuts the stutters, pauses and &ldquo;umms&rdquo;, adds captions, zooms and sound effects in your look, then tells you when it&rsquo;s done. You check it and post.</p>
        <nav class="jump" aria-label="On this page">
          <a href="#start">Start here</a>
          <a href="#flow">The idea</a>
          <a href="#videos">Watch</a>
          <a href="#repos">Free tools</a>
          <a href="#how">How it works</a>
          <a href="#plan">My plan for you</a>
          <a href="#careful">Be careful</a>
        </nav>
      </div>
    </header>

    <main>
      <section id="start" class="band start">
        <div class="in">
          <h2>Start here: one prompt, then your first run</h2>
          <p class="sub">Written for a Windows PC with an Android phone. It uses <a href="https://github.com/onetwothird/Vedit" target="_blank" rel="noopener noreferrer">Vedit</a>, a free editor that runs natively on Windows (the other top skill, talking-head-editor, does not).</p>
          <ol class="steps">
            <li><strong>Open the Claude desktop app</strong> and click the <strong>Code</strong> tab (not normal chat).</li>
            <li><strong>Copy the prompt below</strong> and paste it in. Claude installs everything, checks it works and asks you a few questions about your brand. Say yes to the permission pop-ups when they are for installs.</li>
            <li><strong>Answer its questions</strong> (font, colour, logo, usual video length).</li>
          </ol>
          <figure class="code prompt">
            <figcaption>Setup prompt <button type="button" class="copybtn" data-copy="setup-prompt">Copy prompt</button><span class="copied" role="status" aria-live="polite"></span></figcaption>
            <pre id="setup-prompt">{setupPrompt}</pre>
          </figure>
          <h3>Your first run</h3>
          <ol class="steps">
            <li><strong>Get a clip onto the PC.</strong> Send it from your Android phone with Quick Share, Google Drive or Google Photos, or a USB cable. Use a short, throwaway clip of you talking (30-60 seconds).</li>
            <li><strong>Save it in</strong> <code>Documents\Reels\Inbox</code>.</li>
            <li><strong>In the Code tab, open the folder</strong> <code>Documents\Reels</code>, then type: <em>&ldquo;Edit the clip in Inbox as a reel using my default prompt and brand settings. Notes: keep it about 40 seconds.&rdquo;</em></li>
            <li><strong>Wait a few minutes.</strong> Your finished reel appears in <code>Documents\Reels\Done</code> next to a captions file. Watch it all the way through.</li>
            <li><strong>Tell Claude what to change</strong> in plain words (&ldquo;captions bigger&rdquo;, &ldquo;too many zooms&rdquo;, &ldquo;you cut off my last sentence&rdquo;) and ask it to save that as a standing rule so every future reel keeps it.</li>
          </ol>
        </div>
      </section>

      <section id="flow" class="band alt">
        <div class="in">
          <h2>The idea in one picture</h2>
          <ol class="flow">
            <li><span class="num">1</span><strong>Record</strong><span>Film as normal on your Android phone.</span></li>
            <li><span class="num">2</span><strong>Drop in a folder</strong><span>Copy the clip to your PC&rsquo;s Inbox folder. Add a line of notes if you like: &ldquo;keep it under 45 seconds, focus on posture.&rdquo;</span></li>
            <li><span class="num">3</span><strong>Claude edits</strong><span>Using your default prompt + brand settings + your notes.</span></li>
            <li><span class="num">4</span><strong>You get a ping</strong><span>A notification on your PC when it&rsquo;s finished.</span></li>
            <li><span class="num">5</span><strong>Check &amp; post</strong><span>Watch it, tweak if needed, publish.</span></li>
          </ol>
          <p class="layers"><strong>Three layers of instruction, stacked:</strong> a <em>default prompt</em> (your standing rules) &rarr; the <em>brand file</em> (fonts, colours, logo, music) &rarr; your <em>per-video notes</em>. Your notes sit on top, so you only type what&rsquo;s different this time.</p>

          <h3>What it can do, against your wish list</h3>
          <ul class="cards3">
            <li><strong>Cut the clutter</strong>Stutters, long pauses, &ldquo;umm/ahh&rdquo;, repeated sentences and flubbed takes (it keeps the best take).</li>
            <li><strong>Trim to length</strong>Tell it a target such as &ldquo;about 40 seconds&rdquo; or &ldquo;the best 60&rdquo;.</li>
            <li><strong>Captions</strong>Word-by-word, highlighted as you speak, in your font and colours.</li>
            <li><strong>Zooms &amp; punch-ins</strong>Subtle zooms that hide jump cuts and keep things lively.</li>
            <li><strong>Sound effects</strong>Whooshes, pops and dings timed to the cuts.</li>
            <li><strong>Same look every time</strong>A saved brand file so every reel feels like Vital Fascia.</li>
          </ul>
        </div>
      </section>

      <section id="videos" class="band">
        <div class="in">
          <h2>Watch it in action</h2>
          <p class="sub">Five short tutorials of the same approach. Start with the first two. (Videos load only when you press play.)</p>
          <ul class="videos">
            {videos.map((v) => (
              <li class="video">
                <button type="button" class="facade" data-id={v.id} data-title={v.title} aria-label={`Play video: ${v.title}`}>
                  <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" referrerpolicy="no-referrer" />
                  <span class="play" aria-hidden="true"></span>
                </button>
                <div class="vmeta">
                  <strong>{v.title}</strong>
                  <span class="by">{v.by}</span>
                  <span>{v.why}</span>
                  <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer">Open on YouTube</a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="repos" class="band alt">
        <div class="in">
          <h2>The free tools, compared</h2>
          <p class="sub">All of these are free, open-source &ldquo;skills&rdquo; for Claude. I read each one&rsquo;s GitHub page on 11 Nov 2026. Stars show how many people use it; a small number means newer and less tested, not bad.</p>

          <div class="tablewrap" role="region" aria-label="Comparison table" tabindex="0">
            <table>
              <caption class="sr">How each tool matches your wish list. &ldquo;Yes&rdquo; means supported, &ldquo;Partly&rdquo; means limited, &ldquo;No&rdquo; means not mentioned or not supported.</caption>
              <thead>
                <tr><th scope="col">Tool</th>{checks.map((c) => <th scope="col">{c}</th>)}</tr>
              </thead>
              <tbody>
                {repos.map((r) => (
                  <tr>
                    <th scope="row"><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></th>
                    {r.fit.map((f) => <td class={`r-${f}`}>{f === 'yes' ? '✓ Yes' : f === 'part' ? '◐ Partly' : '✕ No'}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <ul class="repos">
            {repos.map((r) => (
              <li class="repo">
                {r.pick && <span class="pill">{r.pick}</span>}
                <h3><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></h3>
                <p class="stats">{r.stats}</p>
                <p>{r.summary}</p>
                <div class="pc">
                  <div><h4>Good</h4><ul>{r.pros.map((p) => <li>{p}</li>)}</ul></div>
                  <div><h4>Catches</h4><ul>{r.catches.map((p) => <li>{p}</li>)}</ul></div>
                </div>
              </li>
            ))}
          </ul>

          <h3>Building blocks worth knowing</h3>
          <ul class="blocks">
            <li><a href="https://github.com/heygen-com/hyperframes" target="_blank" rel="noopener noreferrer">HyperFrames (HeyGen)</a> Free engine that turns code into video. Its skills add 35 caption styles, motion graphics and 19 free sound effects. Several tools above are built on it.</li>
            <li><a href="https://github.com/nateherkai/hyperframes-student-kit" target="_blank" rel="noopener noreferrer">HyperFrames Student Kit</a> 15 skills including silence and retake cutting that shows you the proposed cuts before it renders.</li>
            <li><a href="https://www.dariusreed.com/claude-video-editing-skills/" target="_blank" rel="noopener noreferrer">8 free skills roundup (Darius Reed)</a> A good overview article of this whole area.</li>
            <li><a href="https://github.com/sasateguh/awesome-ai-video-for-creators" target="_blank" rel="noopener noreferrer">awesome-ai-video-for-creators</a> A community-maintained list of open-source video tools, including Descript-style &ldquo;edit by deleting words&rdquo; editors (Spokecut, CutScript).</li>
          </ul>
        </div>
      </section>

      <section id="how" class="band">
        <div class="in">
          <h2>How this works, in plain English</h2>
          <div class="cols">
            <div>
              <h3>What is a &ldquo;skill&rdquo;?</h3>
              <p>A skill is a folder of instructions and small programs that teaches Claude how to do one job, like editing a talking-head video. You install it once; after that you just talk to Claude: &ldquo;edit this clip, 45 seconds, my usual look&rdquo;.</p>
              <p>Under the hood the heavy lifting is done by free programs on your own Windows PC: <strong>ffmpeg</strong> (cuts and joins video), <strong>Whisper</strong> (turns speech into text with exact timings, so Claude knows where every &ldquo;umm&rdquo; is) and a renderer for captions and graphics. With the free local options (like Vedit), your footage stays on your computer.</p>
            </div>
            <div>
              <h3>Where do I use it?</h3>
              <p>In the <strong>Claude desktop app</strong>, use the <strong>Code</strong> tab (not the normal chat). The Code tab can run programs on your computer, which video editing needs. Plain chat cannot.</p>
              <p>Installing is usually one sentence typed to Claude: <em>&ldquo;Install this skill for me: [GitHub link]. Then run its health check.&rdquo;</em> Claude does the setup. Anthropic&rsquo;s own help page on skills is <a href="https://support.claude.com/en/articles/12512180-get-started-with-claude-skills" target="_blank" rel="noopener noreferrer">here</a>.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="plan" class="band alt">
        <div class="in">
          <h2>My recommendation: three stages</h2>
          <ol class="stages">
            {stages.map((s) => (
              <li>
                <span class="num">{s.n}</span>
                <div><h3>{s.title} <span class="when">{s.when}</span></h3><p>{s.body}</p></div>
              </li>
            ))}
          </ol>

          <h3>What your instructions could look like</h3>
          <p class="sub">An example only, to show the idea. We would tailor this together.</p>
          <div class="cols">
            <figure class="code">
              <figcaption>default-prompt.md (your standing rules)</figcaption>
              <pre>{`Edit the raw clip into a vertical 9:16 reel.
- Remove ums, ahs, stutters, long pauses and repeated sentences. Keep the best take.
- Default length: 30-45 seconds unless my notes say otherwise.
- Word-by-word captions in the brand style, keywords highlighted.
- Subtle zoom-in on emphasis, one sound effect per key point, no more.
- Never cut mid-word. Flag anything you are unsure about.
- Save to Reels/Done and tell me when finished.`}</pre>
            </figure>
            <figure class="code">
              <figcaption>notes.txt (optional, per video)</figcaption>
              <pre>{`Make this one 25 seconds.
Open with the line about desk posture.
Skip the part where I mention the booking page.`}</pre>
              <figcaption class="sep">brand.json (set once)</figcaption>
              <pre>{`{
  "font": "(your brand font)",
  "highlight_colour": "(your accent colour)",
  "logo": "logo.png",
  "intro": "none",
  "outro": "book-now.mp4",
  "music": "off"
}`}</pre>
            </figure>
          </div>
          <p class="sub">The brand file holds your look, so every reel matches. Your notes only say what&rsquo;s different today.</p>
        </div>
      </section>

      <section id="careful" class="band">
        <div class="in">
          <h2>Be careful about</h2>
          <ul class="risks">{risks.map((r) => <li>{r}</li>)}</ul>

          <h3>If you&rsquo;d rather pay and skip the setup</h3>
          <p>Apps like CapCut, Submagic, Opus Clip and Descript do automatic captions and filler-word removal in the browser or on your phone, with no installing. The trade-off is a monthly fee, less control over a consistent look, and your footage is usually uploaded to their servers. Check current pricing on their sites before deciding. They are worth a look if the free route feels like too much.</p>

        </div>
      </section>
    </main>

    <footer class="foot"><div class="in"><p>Prepared 11 Nov 2026 for Alex. Private page, please don&rsquo;t share the link. Facts about each tool were read from its public GitHub page on that date and may change.</p></div></footer>

    <script is:inline>
      (function () {
        document.querySelectorAll('.copybtn').forEach(function (b) {
          b.addEventListener('click', function () {
            var pre = document.getElementById(b.dataset.copy); var note = b.parentNode.querySelector('.copied');
            var done = function (m) { note.textContent = m; setTimeout(function () { note.textContent = ''; }, 3000); };
            if (navigator.clipboard) { navigator.clipboard.writeText(pre.innerText).then(function () { done('Copied!'); }, function () { done('Select the text and press Ctrl+C'); }); }
            else { done('Select the text and press Ctrl+C'); }
          });
        });
        document.querySelectorAll('.facade').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var f = document.createElement('iframe');
            f.src = 'https://www.youtube-nocookie.com/embed/' + btn.dataset.id + '?autoplay=1&rel=0';
            f.title = btn.dataset.title;
            f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
            f.allowFullscreen = true;
            f.referrerPolicy = 'strict-origin-when-cross-origin';
            btn.replaceWith(f);
            f.focus();
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  body { margin: 0; background: var(--bone); color: var(--ink); font-family: var(--font-body); line-height: 1.6; }
  .in { max-width: var(--wrap-max); margin: 0 auto; padding: 0 var(--gutter); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  h1, h2, h3, h4 { font-family: var(--font-display); line-height: 1.15; margin: 0 0 .5em; font-weight: 500; }
  h1 { font-size: clamp(2.2rem, 7vw, 4rem); }
  h2 { font-size: clamp(1.7rem, 4.5vw, 2.4rem); }
  h3 { font-size: 1.3rem; margin-top: 2rem; }
  h4 { font-size: 1rem; font-family: var(--font-body); font-weight: 600; margin-bottom: .25rem; }
  p { margin: 0 0 1em; }
  a { color: var(--olive-dark); text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible, .tablewrap:focus-visible { outline: 3px solid var(--olive); outline-offset: 3px; }
  ul, ol { padding-left: 1.2rem; }

  .hero { background: var(--charcoal); color: var(--cream); padding: 3.5rem 0 2rem; }
  .hero a { color: var(--cream); }
  .hero em { font-style: italic; color: var(--sage); }
  .eyebrow-l { text-transform: uppercase; letter-spacing: .14em; font-size: .8rem; color: var(--cream-muted); margin-bottom: 1rem; }
